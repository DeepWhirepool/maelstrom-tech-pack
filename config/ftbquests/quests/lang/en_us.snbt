	quest.48F0686E231A133E.quest_desc: ["Джетпак Mekanism, заправка водородом."]
	quest.49B9718F8340DB2B.title: "Скороходы и баллон"
	quest.49B9718F8340DB2B.quest_desc: ["Скороходы и акваланг Mekanism."]
	quest.C2ABCDA0BB3E7642.title: "Атомный дезинтегратор"
	quest.C2ABCDA0BB3E7642.quest_desc: ["Инструмент Mekanism: копает всё, большой заряд."]
