	quest.49B9718F8340DB2B.quest_desc: ["Ядро + стабилизаторы + пилон: большое хранилище энергии."]
	quest.C2ABCDA0BB3E7642.title: "Сердце дракона"
	quest.C2ABCDA0BB3E7642.quest_desc: ["Падает с ванильного Эндер-дракона."]
