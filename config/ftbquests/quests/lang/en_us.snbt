	quest.B598B667E31E5713.quest_desc: ["Терминал крафта и ME-сундук — доступ к сети."]
	quest.BFD6BB40D5A2E806.title: "Шины"
	quest.BFD6BB40D5A2E806.quest_desc: ["Шины импорта и экспорта: автоматизация машин."]
	quest.DCB6E8A748BA9FEA.title: "Автокрафт"
	quest.DCB6E8A748BA9FEA.quest_desc: ["Молекулярный сборщик, поставщик шаблонов и блок крафта."]
	quest.9F16C8679A867F0D.title: "ExtendedAE"
	quest.9F16C8679A867F0D.quest_desc: ["Расширенные поставщик шаблонов и накопитель ExtendedAE."]
