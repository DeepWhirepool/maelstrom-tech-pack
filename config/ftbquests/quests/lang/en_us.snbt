	quest.E78B788BCC67A74C.quest_desc: ["Руда дракониума, переплавка."]
	quest.147A964CC9EEE6F7.title: "Ядро дракониума"
	quest.147A964CC9EEE6F7.quest_desc: ["Верстак Draconic. Основа слияния."]
