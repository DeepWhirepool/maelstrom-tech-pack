	quest.102C277957A9C63C.quest_desc: ["Высекатель: логический, вычислительный и инженерный процессоры."]
	quest.31C7358EA0E24375.title: "ME-контроллер"
	quest.31C7358EA0E24375.quest_desc: ["Верстак (рецепт LoliLand): небесный камень + флюикс + усложнённая схема IU."]
	quest.12C064C71E090880.title: "Хранение"
	quest.12C064C71E090880.quest_desc: ["ME-накопитель и ячейка 1k (кварцевое стекло, редстоун, компонент 1k, железо)."]
