	quest.658A7D6014FB85B9.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лестница Forestry: синяя/зелёная/фиолетовая/янтарная → улучшенные → ультимативная четырёхцветная.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужны маточное молочко, пыльца и пропитанные рамки — заведи пасеку заранее.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ультимативная четырёхцветная — одна из \"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" «ультимативных» для искрящейся панели.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пропитанная рамка Forestry — в рецепте первой панели.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь на открытом небе.\"}]}"]
	quest.673B73A4FE247D39.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Флуктуационная панель\"}]}"
	quest.673B73A4FE247D39.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Четвёртый тир. Ядро — с экстремального стола; нужен Avaritia.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" анизотропные + гравитомагнитная + ядро и материя тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ночью \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"/\"}, {\"text\": \"4.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Открывает лестницу стражей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каждый тир ≈ ×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" к прошлому.\"}]}"]
	quest.5C62945632894976.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Панели стражей\"}]}"
	quest.5C62945632894976.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лестница стражей: хаоса, холода … убийца драконов. Боссов модов в сборке нет — детали делаются технически (слияние, хаос-осколки).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ультимативная «убийца драконов» — одна из \"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" «ультимативных» для искрящейся панели.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепты — в JEI.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь на открытом небе.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Осколки хаоса — из ветки «Draconic: хаос и реактор».\"}]}"]
	quest.1792F8E64AFDE11D.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Аберрационная панель\"}]}"
	quest.1792F8E64AFDE11D.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пятый тир. Материя — из старших слияний Draconic (нужны инжекторы виверны/дракона).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" флуктуационные + анизотропная + ядро и материя тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ночью \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"/\"}, {\"text\": \"4.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Открывает лестницу путешественника.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каждый тир ≈ ×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" к прошлому.\"}]}"]
	quest.356DE8B814AA6CDF.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Панели путешественника\"}]}"
	quest.356DE8B814AA6CDF.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лестница путешественника: кошмары, мечта, мортум, таинственное подземелье → ультимативная путешественника измерений.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Тематические «измерения» LoliLand у нас заменены деталями модов сборки.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ультимативная путешественника измерений — одна из \"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" «ультимативных» для искрящейся панели.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепты — в JEI.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь на открытом небе.\"}]}"]
	quest.7DAB113735690F76.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Параметрическая панель\"}]}"
	quest.7DAB113735690F76.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Шестой тир. Дальше — хромодинамическая и антиматериальная.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" аберрационные + флуктуационная + ядро и материя тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ночью \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"/\"}, {\"text\": \"4.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ядро — экстремальный стол.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каждый тир ≈ ×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" к прошлому.\"}]}"]
	quest.14B878BB8E502168.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Хромодинамическая панель\"}]}"
	quest.14B878BB8E502168.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Седьмой тир. Для ядра нужна антиматерия Mekanism.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" параметрические + аберрационная + ядро и материя тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ночью \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"/\"}, {\"text\": \"4.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Антиматерию копи заранее (SPS).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каждый тир ≈ ×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" к прошлому.\"}]}"]
	quest.011B4A288DE1EB73.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Антиматериальная панель\"}]}"
	quest.011B4A288DE1EB73.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Восьмой, высший тир обычной лестницы. Анимированная текстура — узнаешь сразу.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Шесть «ультимативных» панелей разных лестниц + искрящееся ядро дают искрящуюся панель (ветка финала).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" хромодинамические + параметрическая + ядро и материя тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ночью \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"/\"}, {\"text\": \"4.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Антиматериальное ядро — деталь искрящегося ядра (финал).\"}]}"]
	chapter.7900513677B7D21F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Draconic Evolution\"}]}"
	quest.13309691801B0136.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Что такое Draconic Evolution\"}]}"
	quest.13309691801B0136.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Draconic Evolution — поздний мод: драконий металл, слияние (fusion crafting), энергоядро на миллиарды FE, реактор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сердце дракона даёт победа над Эндер-драконом — путь в Край обязателен.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия Draconic — FE; машины DE принимают её как обычные.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Броня Draconic: виверна → драконья → хаоса, щит из энергии.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дракониевая руда видна плохо — бери с собой ночное зрение.\"}]}"]
	quest.3E37F5E4C238581E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Дракониум\"}]}"
	quest.3E37F5E4C238581E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Руда дракониума — глубоко в обычном мире, в Незере и в Крае. Пыль/руду плавь в слитки.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Руда в обычном мире редкая, в Крае — чаще.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пыль дракониума — дробилка; ×\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" через обогатитель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Блок дракониума — топливо реактора после пробуждения.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Копи дракониум заранее: много уходит на ядра и инжекторы.\"}]}"]
	quest.5C05D89E4B0C0969.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Ядро дракониума\"}]}"
	quest.5C05D89E4B0C0969.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Базовое ядро DE: из него инжекторы, генератор DE, ядро виверны.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: дракониум + алмазы + золото на верстаке.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Из него — инжекторы, генератор DE, ядро виверны.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ядро нужно и некоторым нашим рецептам паутины.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Делай с запасом — \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" штук.\"}]}"]
	quest.0D725515845EC64E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Слияние (fusion crafting)\"}]}"
	quest.0D725515845EC64E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ядро слияния в центре, инжекторы смотрят на него с расстояния (в линию, через пустоту). В ядро — главный предмет, в инжекторы — ингредиенты.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия подаётся в инжекторы. Тир инжектора ограничивает тир рецепта.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Инжекторы тиров: базовый → виверны → драконий → хаоса.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Расстояние инжекторов до ядра — до \"}, {\"text\": \"16\", \"color\": \"#E0C8FF\"}, {\"text\": \" блоков по прямой.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия подаётся в каждый инжектор (кабель/кристалл).\"}]}"]
	quest.72735F288CEFDEBA.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Ядро виверны\"}]}"
	quest.72735F288CEFDEBA.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Гейт ступени S\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" (эндгейм): турбина, термояд, мощные реакторы Powah, IE-дизель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Слияние: ядро дракониума + звезда Незера + дракониум + заряженный аметрин.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Звезду Незера даёт Иссушитель — его вызывай подальше от базы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ядро виверны открывает эндгейм-генераторы и инструменты.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Делай сразу \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" штук.\"}]}"]
	quest.5DDA1DE294B6D9F0.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Пробуждённый дракониум\"}]}"
	quest.5DDA1DE294B6D9F0.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Слияние: дракониум + сердце дракона + ядра. Нужен драконьей броне и инструментам, реактору.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сердце дракона — с Эндер-дракона (его можно вызвать заново кристаллами Края).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пробуждённое ядро — для звёздного ядра Maelstrom.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пробуждённый дракониум — главный металл эндгейма Draconic.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужны инжекторы виверны и больше.\"}]}"]
	quest.1F944D866D73CC81.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Осколок хаоса\"}]}"
	quest.1F944D866D73CC81.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В LoliLand осколки падают с Хаос-стража. У нас боссов модов нет: осколок делается техническим слиянием (рецепт web_\"}, {\"text\": \"7,\", \"color\": \"#E0C8FF\"}, {\"text\": \" смотри JEI).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Большие фрагменты — разбор осколка. Нужны хаотичному ядру и реактору.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Осколок разбирается на большие и малые фрагменты (верстак).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужны слияния уровня draconic.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Копи \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" осколков.\"}]}"]
	quest.155B9B87C1778369.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Хаотичное ядро\"}]}"
	quest.155B9B87C1778369.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Высшее ядро Draconic: слияние уровня draconic (рецепт LoliLand).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужно хаотичным инжекторам, реактору и броне хаоса.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Хаотичные инжекторы позволяют слияния высшего уровня.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Для брони хаоса ядер нужно несколько.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт — слияние, смотри JEI.\"}]}"]
	quest.765B3C64E4F9C042.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Генератор энергии хаоса\"}]}"
	quest.765B3C64E4F9C042.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Вершина лестницы генераторов (LoliLand): мультиблок \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" на осколках хаоса — \"}, {\"text\": \"8 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE/т постоянно.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Низ — \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" внеземных оснований, середина — \"}, {\"text\": \"7\", \"color\": \"#E0C8FF\"}, {\"text\": \" внеземных стёкол, камера хаоса в центре и генератор на лицевой стороне, верх — \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" внеземных покрытий.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Shift+ПКМ пустой рукой по генератору — призрак недостающих блоков; ПКМ — сборка, потом окно.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Топливо: осколок хаоса горит \"}, {\"text\": \"30 мин\", \"color\": \"#E0C8FF\"}, {\"text\": \" (≈\"}, {\"text\": \"288\", \"color\": \"#E0C8FF\"}, {\"text\": \" млрд FE), большой фрагмент — \"}, {\"text\": \"200 с\", \"color\": \"#E0C8FF\"}, {\"text\": \", средний — \"}, {\"text\": \"22 с\", \"color\": \"#E0C8FF\"}, {\"text\": \", маленький — \"}, {\"text\": \"2,5 с\", \"color\": \"#E0C8FF\"}, {\"text\": \".\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В отличие от реактора Draconic — без взрывов, без накачки и настройки поля: положил осколок — получил энергию.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергию отдаёт сам в соседние блоки, а кабели можно цеплять к любому блоку корпуса.\"}]}"]
	chapter.64817B247D992A44.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Avaritia и финал\"}]}"
	quest.279EAAF602187BCE.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Что такое Avaritia\"}]}"
	quest.279EAAF602187BCE.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Avaritia — «бесконечность»: стол экстремального крафта \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"9,\", \"color\": \"#E0C8FF\"}, {\"text\": \" нейтроний, сингулярности, слиток бесконечности.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В нашей сборке сингулярности делает жидкостный нейтронный компрессор нашего мода.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Экстремальный стол \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \": рецепты огромные, смотри их в JEI.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нейтронный сборщик работает сам, но медленно — поставь несколько.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Avaritia — последняя ступень перед финалом.\"}]}"]
	quest.3CFCBBF71503AF57.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Нейтроний\"}]}"
	quest.3CFCBBF71503AF57.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нейтронный сборщик медленно копит нейтронную кучку. \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" кучек → самородок → слиток.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нейтронный сборщик не просит энергии — просто стоит.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нейтроний нужен нейтронной звезде Maelstrom и катализатору бесконечности.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" сборщиков в прогруженном чанке.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нейтронный компрессор Avaritia делает сингулярности из блоков.\"}]}"]
	quest.005B78DE41DC55E0.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Кристальная матрица\"}]}"
	quest.005B78DE41DC55E0.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Алмазы + звёзды Незера на столе экстремального крафта. Звёзды — Иссушитель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Алмазная решётка: алмазы + звёзды Незера на столе.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Звёзды Незера — с Иссушителя (ванильный босс разрешён).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Матрица идёт в катализатор и инструменты Avaritia.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Копи звёзды заранее.\"}]}"]
	quest.2EDAFC134877282C.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Слиток бесконечности\"}]}"
	quest.2EDAFC134877282C.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Стол экстремального крафта: катализатор бесконечности + нейтроний. Катализатор — из всех сингулярностей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Слиток бесконечности — основа брони/инструментов бесконечности и финальных панелей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Катализатор требует всех сингулярностей — заранее поставь нейтронные компрессоры.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Самоцель для коллекционеров: меч и кирка бесконечности.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Это предпоследний шаг: дальше — квантовый генератор.\"}]}"]
	quest.685E1B019FB63CD8.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Квантовый генератор\"}]}"
	quest.685E1B019FB63CD8.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"ФИНАЛ сборки (как у LoliLand): квантовый генератор \"}, {\"text\": \"0\", \"color\": \"#E0C8FF\"}, {\"text\": \" → \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" → \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" → \"}, {\"text\": \"3.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каждый следующий собирается из предыдущего и деталей всех веток: ядер, материй, панелей, сингулярностей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Поздравляем — ты прошёл всю паутину.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Генераторы \"}, {\"text\": \"0\", \"color\": \"#E0C8FF\"}, {\"text\": \"–III работают всегда, без неба и топлива.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"III выдаёт \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"632\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"586\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"752 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" — финал сборки.\"}]}"]
	quest.4F70B9B04A72B6F4.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Жидкостный нейтронный компрессор\"}]}"
	quest.4F70B9B04A72B6F4.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Наш мод: \"}, {\"text\": \"64\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ жидкости → жидкая сингулярность. \"}, {\"text\": \"200 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE (~\"}, {\"text\": \"11 мин\", \"color\": \"#E0C8FF\"}, {\"text\": \").\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Жидкости — расплавы из термоядерного комплекса (металлы) и обычные (лава, вода …). \"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" видов сингулярностей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Вход жидкостью с любой стороны, выход сингулярности — в сундук рядом.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Строится как обычный блок (не мультиблок).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшение скорости Maelstrom ускоряет.\"}]}"]
	quest.2F5F0292F8133FE5.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Жидкие сингулярности\"}]}"
	quest.2F5F0292F8133FE5.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сингулярности всех видов — ингредиенты катализатора бесконечности и финальных панелей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" видов: лава, вода и расплавы металлов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Расплавы делает Термоядерный комплекс.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сингулярности стакаются.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Копи все виды — нужны для катализатора бесконечности.\"}]}"]
	quest.0AAAEF91F10CCD26.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Вечная сингулярность\"}]}"
	quest.0AAAEF91F10CCD26.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Экстремальный стол: сингулярности. Аналог «сингулярности бесконечности» LoliLand — нужна искрящимся панелям и квантовому генератору.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Делается один раз на крупную деталь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужны все виды сингулярностей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт — экстремальный стол (JEI).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Входит в искрящиеся панели.\"}]}"]
	quest.4690EB77DBE5F1DD.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Искрящееся ядро\"}]}"
	quest.4690EB77DBE5F1DD.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Антиматериальное ядро + голографическое термодинамическое ядро + искрящаяся материя (экстремальный стол).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужен один раз на искрящуюся панель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт — экстремальный стол (JEI).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Искрящаяся материя — дуговая печь IE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Предпоследний шаг перед квантовым генератором.\"}]}"]
	quest.77B70DB7B88E5812.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Искрящаяся панель\"}]}"
	quest.77B70DB7B88E5812.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" ультимативных панелей разных лестниц + искрящееся ядро. Днём \"}, {\"text\": \"214\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"990\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"848 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \"; из розового золота — \"}, {\"text\": \"322\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"486\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"272 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \".\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Последний шаг перед квантовым генератором.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь на открытом небе.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Шесть «ультимативных» — по одной из каждой лестницы (солнечная, термо, электролиз, пчеловод, стражи, путешественник).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Деталь квантового генератора.\"}]}"]
	quest.2373493C0B6C7574.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Легендарный сборочный комплекс\"}]}"
	quest.2373493C0B6C7574.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Финальный «стол» сборки LoliLand: только в нём собираются квантовые генераторы \"}, {\"text\": \"0\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" и улучшение квантового генератора.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Мультиблок \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \": пол и потолок — легендарный корпус, стены — корпус по углам и легендарное стекло, внутри пусто, в самом центре — легендарное ядро.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Комплекс ставится в середину нижнего пояса передней стены. Shift+ПКМ пустой рукой — призрак недостающих блоков, ПКМ — сборка, затем окно.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужно: \"}, {\"text\": \"62\", \"color\": \"#E0C8FF\"}, {\"text\": \" корпуса (\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" крафтов), \"}, {\"text\": \"35\", \"color\": \"#E0C8FF\"}, {\"text\": \" стёкол (\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" крафтов), \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" ядро. Энергия и тёмный энергоний подаются в любой блок корпуса (ведро — по комплексу).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Операции долгие: \"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"20\", \"color\": \"#E0C8FF\"}, {\"text\": \" минут и \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" млрд FE (до \"}, {\"text\": \"333\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \"). Без энергии комплекс ждёт, входы списываются только в конце.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"До \"}, {\"text\": \"18\", \"color\": \"#E0C8FF\"}, {\"text\": \" видов предметов в \"}, {\"text\": \"18\", \"color\": \"#E0C8FF\"}, {\"text\": \" слотах — раскладывай как удобно, комплекс сам найдёт рецепт.\"}]}"]
	quest.35B6538C80F903FE.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Квантовый генератор \"}, {\"text\": \"0\", \"color\": \"#E0C8FF\"}]}"
	quest.35B6538C80F903FE.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Работает всегда, без неба: \"}, {\"text\": \"483\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"729\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"408 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \". Генератор I — \"}, {\"text\": \"725\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"594\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"112,\", \"color\": \"#E0C8FF\"}, {\"text\": \" II — \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"088\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"391\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"168,\", \"color\": \"#E0C8FF\"}, {\"text\": \" III (финал) — \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"632\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"586\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"752 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \".\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Собирается только в легендарном сборочном комплексе: \"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" минут, \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" млрд FE и \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ тёмного энергония (I — \"}, {\"text\": \"12 мин\", \"color\": \"#E0C8FF\"}, {\"text\": \", II — \"}, {\"text\": \"15,\", \"color\": \"#E0C8FF\"}, {\"text\": \" III — \"}, {\"text\": \"20\", \"color\": \"#E0C8FF\"}, {\"text\": \").\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Генераторы собираются по очереди: \"}, {\"text\": \"0\", \"color\": \"#E0C8FF\"}, {\"text\": \" → I → II → III.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь и подключай кабелем — выдаёт FE во все стороны.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Неба и топлива не нужно.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Генератор III — финальный квест паутины.\"}]}"]
	quest.7B1EDE2751B36BD6.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Улучшение: Квантовый генератор\"}]}"
	quest.7B1EDE2751B36BD6.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Легендарная сборка LoliLand: \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" солнечные панели старших тиров и их ядра, \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" флуктуационные панели, \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" сингулярностей и \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" хаотичных ядер.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"15\", \"color\": \"#E0C8FF\"}, {\"text\": \" минут, \"}, {\"text\": \"400 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE и \"}, {\"text\": \"20\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ тёмного энергония.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"ПКМ улучшением по квантовому генератору \"}, {\"text\": \"0\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" — +\"}, {\"text\": \"30%\", \"color\": \"#E0C8FF\"}, {\"text\": \" выработки навсегда (на генераторе III ≈\"}, {\"text\": \"2,12\", \"color\": \"#E0C8FF\"}, {\"text\": \" млрд FE/т).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Одно улучшение на генератор; сломанный генератор улучшение теряет — ставь его один раз и навсегда.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Это последняя цель сборки: максимальная мощность, которую только можно получить.\"}]}"]
	chapter.2C69A38E1998C414.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Необязательное\"}]}"
	quest.3D576CABB7782A7E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Жидкостные улучшения\"}]}"
	quest.3D576CABB7782A7E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выталкиватель жидкостей сам сливает жидкость из бака машины IU в соседний бак/трубу, затягиватель — набирает.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь их в машины с жидкостью: промыватель руд (вода), геотермальный генератор (лава).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Без выталкивателя жидкости машина IU с полным баком встаёт.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сторона выбирается так же, как у обычного выталкивателя.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: в промыватель руд ставь затягиватель жидкости рядом с баком воды.\"}]}"]
	quest.523A7A24FEEB165E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Батпак\"}]}"
	quest.523A7A24FEEB165E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ранец-батарея: заряжает электроинструмент в руках на ходу.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лазуротроновый ранец — то же, но в разы больше.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ранец заряжает предметы в руках, а не всю броню.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшенный батпак и лазуротроновый ранец — больше ёмкость.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжающие аккумуляторы IU — альтернатива ранцу (лежат в инвентаре).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжай ранец в MFE/MFSU.\"}]}"]
	quest.0B2B70BF99FA97D1.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Джетпак Mekanism\"}]}"
	quest.0B2B70BF99FA97D1.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Летает на водороде. Заправляй в электролитическом сепараторе (слот предмета) или в баке водорода.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Режимы: обычный, зависание (Hover) — переключаются клавишей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Водород заправляется в электролитическом сепараторе (слот снизу) или из бака водорода.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Шлем Mekanism с дыхательным модулем — тоже на водороде/кислороде.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"MekaSuit — эндгейм-броня Mekanism.\"}]}"]
	quest.42FB6E1081899E6C.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Энергоядро\"}]}"
	quest.42FB6E1081899E6C.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Хранилище на миллиарды FE. Мультиблок: ядро + \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" стабилизатора по сторонам + оболочка из блоков (растёт с тиром).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия входит/выходит через энергопилоны. Заряд виден на ядре.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Тиры ядра \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \": оболочка из блоков редстоуна/дракониума растёт с тиром.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Стабилизаторы ставь на одинаковом расстоянии с \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" сторон — призрак схемы показывает места.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пилон работает в режиме вход или выход (ПКМ).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пустое ядро без стабилизаторов не работает.\"}]}"]
	quest.19701EDCF3806384.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Цифровой шахтёр\"}]}"
	quest.19701EDCF3806384.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Копает руду в радиусе до \"}, {\"text\": \"32\", \"color\": \"#E0C8FF\"}, {\"text\": \" блоков вокруг себя, не ломая ничего, кроме выбранного фильтром.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Настрой фильтр (например, тег руд #c:ores), радиус и высоту, поставь сундук/транспортёр сзади. Ест много FE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Работает только в прогруженном чанке. Улучшения скорости и энергии сильно помогают.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Шахтёр оставляет пустоты — не ставь его под базой.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Режим «тихое касание» (silk touch) ест больше энергии.\"}]}"]
	quest.6CD3784F48F997D6.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Телепорт\"}]}"
	quest.6CD3784F48F997D6.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Телепорт Mekanism: блок телепорта + рамка из блоков рамки телепорта вокруг прохода \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" (схема в JEI/справке).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Частота как у запутывателя. Оба телепорта на одной частоте — шагнул в рамку, вышел у другого. Работает между измерениями, ест FE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Портативный телепорт в руке — то же без рамки.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Телепорт расходует энергию за каждый переход — больше расстояние, больше FE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Для друга сделай общую частоту.\"}]}"]
	quest.45E61B1DCA536B5E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"QIO — хранилище Mekanism\"}]}"
	quest.45E61B1DCA536B5E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Беспроводное хранилище предметов Mekanism (альтернатива AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"): массив дисков + диски QIO + панель (dashboard) на частоте.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Импортёр/экспортёр QIO подключают машины. Удобно для отдалённых построек — без кабелей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Диски QIO: базовый → продвинутый → элитный → ультимативный (ёмкость растёт).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Терминал QIO можно носить — портативная панель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" и QIO можно связать через импортёр/экспортёр.\"}]}"]
	quest.717DDD37BF42D668.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Фабрика Mekanism\"}]}"
	quest.717DDD37BF42D668.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совершенная обогатительная фабрика: \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" операций обогащения параллельно. Фабрики бывают для любой машины Mekanism (базовая \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" → \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" → \"}, {\"text\": \"7\", \"color\": \"#E0C8FF\"}, {\"text\": \" → \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" слотов).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Фабрика улучшается из машины апгрейд-ключами Mekanism (базовый → … → ультимативный).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каждый слот работает параллельно.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь улучшения скорости.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Тоже FE.\"}]}"]
	quest.1A3A72B01D1F4D7E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Реактор Draconic\"}]}"
	quest.1A3A72B01D1F4D7E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Самый мощный и самый опасный генератор: ядро реактора, \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" стабилизатора вокруг и энергоинжектор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Топливо — драконитовые блоки. Запуск: зарядить (энергия в инжектор) → активировать → забирать энергию из стабилизаторов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Главное правило: поле сдерживания и насыщение держать под контролем, иначе взрыв уничтожит большую область. Используй логику (redstone) для аварийного отключения.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь вдали от базы и в прогруженном чанке.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Перед первым запуском прочитай описание блока в JEI/справочнике Draconic.\"}]}"]
	quest.0E488195FABA52D1.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Кварковый реактив\"}]}"
	quest.0E488195FABA52D1.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Слияние хаоса Draconic: экзотермический реактив + \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" кристалла перезарядки Oritech. Нужен лестнице плазмореактивов Maelstrom Tech.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Кварковый реактив — один из \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" плазмореактивов (фазовый, кварковый …).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Плазмореактивы входят в панели LoliLand и финальные детали.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт — слияние хаоса.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужны \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" кристалла перезарядки Oritech.\"}]}"]
	quest.2BE67F4910F385CE.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Энергоячейки\"}]}"
	quest.2BE67F4910F385CE.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Золотая → бесконечная → демоническая (экстремальный стол). Принимают FE с \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" сторон, отдают вниз: \"}, {\"text\": \"200 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" / \"}, {\"text\": \"800 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" / \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" млрд FE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сломанная ячейка сохраняет заряд.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Принимают FE с \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" сторон, отдают вниз.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Демоническая ячейка — эндгейм-хранилище.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт — экстремальный стол.\"}]}"]
	quest.30F4C46B86109A73.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Инвентарные генераторы\"}]}"
	quest.30F4C46B86109A73.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"EU-генераторы I–V: лежат в инвентаре и заряжают броню и инструменты (от \"}, {\"text\": \"16\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"384\", \"color\": \"#E0C8FF\"}, {\"text\": \" до \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"194\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"304 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \"). Собираются из солнечных панелей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лежат в инвентаре: работают как заряжающая батарея огромной мощности.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пять тиров: I…V.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт — из солнечных панелей LoliLand.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Не ставятся блоком.\"}]}"]
	quest.136C9B98AB2CE008.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Заряжающий аккумулятор\"}]}"
	quest.136C9B98AB2CE008.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лежит в инвентаре и сам заряжает электроинструмент и броню. Дальше: улучшенный → энергокристалл → лазуротрон (каждый больше).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"ВАЖНО: по умолчанию батарея выключена. Включи режим клавишей режима IU (см. Настройки → Управление → Industrial Upgrade), держа батарею в руке.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжается в хранилище IU (MFE, MFSU) как обычный аккумулятор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Батарея отдаёт энергию предметам по очереди — держи её заряженной.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лазуротроновая заряжающая — для квантовой брони.\"}]}"]
	quest.72F6EAE4EAA36696.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Нано-дрель\"}]}"
	quest.72F6EAE4EAA36696.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Средний этап: копает как алмазная дрель, но быстрее и экономнее, есть режимы (одиночный блок / область).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: алмазная дрель + армированный сплав Mekanism + заряженный хризолит + углепластик + энергокристалл.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Режимы переключаются клавишей режима IU. Ест EU — носи заряжающий аккумулятор или ранец.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь «тихое касание» для руд, которые хочешь сохранить блоком.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нано-дрель — деталь улучшенной алмазной дрели.\"}]}"]
	quest.366F6BBB59C711CE.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Квантовые инструменты\"}]}"
	quest.366F6BBB59C711CE.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Квантовые кирка, топор и лопата: очень быстрые, почти без расхода. Поздний этап.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: алмазный инструмент + квантовый сплав + иридиевая пластина + лазуротроны + плата т\"}, {\"text\": \"3.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Иридий — только из UU-материи, так что начинай копить генератором материи заранее.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Квантовый топор рубит деревья быстрее, лопата — песок и землю.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Все три — для любителей «ручной» добычи; для автоматики есть шахтёр и бур.\"}]}"]
	quest.70DD2B83F87E368E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Улучшенная алмазная дрель\"}]}"
	quest.70DD2B83F87E368E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Перед эндгеймом: копает большой областью, режимы как у нано-дрели. Рецепт с ядром виверны.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Режимы: \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"1,\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3,\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" — клавиша режима IU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжай в MFSU или заряжающей батареей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ест больше, чем нано-дрель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Деталь — ядро виверны.\"}]}"]
	quest.2C175976D6266550.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Ваджра\"}]}"
	quest.2C175976D6266550.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Легендарный инструмент GraviSuite/LoliLand: мгновенно ломает почти любой блок, режим «тихое касание» (silk touch) переключается.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: углепластик + квантовый сплав + заряженный аметрин + ядро виверны + лазуротрон. Ест много EU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжай в MFSU/энергокубе.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Не бьёт мобов — это инструмент.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Вершина инструментов IU в сборке.\"}]}"]
}
