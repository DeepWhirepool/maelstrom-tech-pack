	quest.433AF2610848D066.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Третий тир. С этого момента солнечная энергия обгоняет большинство реакторов среднего уровня.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" гравитомагнитные + дисперсионная + ядро и материя тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ночью \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"/\"}, {\"text\": \"4.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Открывает пчеловодческую лестницу.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Подключай к энергоядру/матрице.\"}]}"]
