	quest.2D12A54A7C835531.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лестница материй: материя IU → сыпучая розовая → светящаяся розовая → мутированная → бирюзовая → фиолетовая →\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"светящаяся бирюзовая → светящаяся красная → сыпучая голубая → искрящаяся. Каждую делает генератор своего тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Материя тира — второй ключевой ингредиент солнечной панели того же тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Материй \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" видов (+искрящаяся) — по одной на тир панели.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"С тира \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" генератор берёт \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" предыдущих материи, на T\"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" — \"}, {\"text\": \"4.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Слияние Draconic для материй больше не нужно.\"}]}"]
