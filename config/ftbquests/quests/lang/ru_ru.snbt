	quest.0EDD58DAFCFE30C1.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лестница из электролизованных металлов: бронзовая → светокаменная → обсидиановая → осмиевая → ультимативная мультисплавная.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Металлы электролизуют машины Mekanism/IE. Конденсаторы тиров — из той же линии.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ультимативная мультисплавная — одна из \"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" «ультимативных» для искрящейся панели.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Конденсаторы тиров — деталь каждой ступени.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь на открытом небе.\"}]}"]
