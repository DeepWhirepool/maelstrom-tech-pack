	quest.5EFFEA0BF428D66B.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Второй тир: ×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" к дисперсионной. Рецепт: \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" дисперсионные + квантовая IU + ядро и материя тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: панели ставь сразу на кабель Flux/Mekanism, буфер у них большой.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ночью выдаёт \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"/\"}, {\"text\": \"4.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужно открытое небо.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Отдаёт энергию соседям сама.\"}]}"]
