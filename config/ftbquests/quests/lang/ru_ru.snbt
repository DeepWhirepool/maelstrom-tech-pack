{
	file.0000000000000001.title: "Maelstrom Tech"
	chapter.3EEEA95ECFE88051.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Начало и металлы\"}]}"
	quest.1D79CEACEA21937D.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Начало пути\"}]}"
	quest.1D79CEACEA21937D.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Добро пожаловать в Maelstrom Tech! Это техно-сборка: здесь нет магии, всё делается машинами.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Книга разбита на главы (список слева) в порядке прохождения: металлы, Industrial Upgrade, энергия, жидкости, Mekanism, кристаллы, AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" … финал. В каждой главе путь идёт слева направо, отростки — строками ниже. Глава «Необязательное» — то, без чего можно дойти до финала.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каждый квест — один предмет. Сделай его, и откроются следующие. Ветки сходятся там, где рецепт требует деталей из двух веток.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт любого предмета: наведи курсор и нажми R (как сделать) или U (где используется) — это JEI, справочник рецептов справа на экране.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Крупные шестиугольники — ключевые шаги (новый тир, мультиблок, новый вид энергии). Шестерёнки — вводные квесты про моды: в них нечего делать, просто нажми «Выполнить».\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Первым делом: сруби дерево, сделай верстак.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет новичку: копи ресурсы в сундуках с самого начала — железо, медь, олово, уголь, редстоун уходят тысячами.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Колёсико мыши — приблизить/отдалить карту квестов; двигать карту — зажать кнопку мыши и тянуть.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Клик по предмету в задаче квеста открывает его рецепт в JEI; там нажми A — рецепт закрепится в закладках слева.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Можно делать вещи наперёд — задание засчитается, а награду дадут, когда дойдёшь до него по цепочке.\"}]}"]
	quest.1826BC54A7EAFAB0.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Прогрузка чанков (FTB Chunks)\"}]}"
	quest.1826BC54A7EAFAB0.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машины работают, только пока чанк загружен (рядом игрок). Чтобы база работала без тебя:\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \") Открой карту (клавиша M). \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \") Зажми ЛКМ и выдели чанки базы — они станут твоими (защищены). \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \") Shift+ЛКМ по своим чанкам — прогрузка (иконка цепи).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Прогрузка работает и когда ты вышел из игры. Лимит — \"}, {\"text\": \"25\", \"color\": \"#E0C8FF\"}, {\"text\": \" чанков на команду, хватит на большую базу.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Квантовый запутыватель, термояд, лазерный бур — ставь только в прогруженных чанках.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Если машины «засыпают», когда уходишь, — значит чанк не прогружен.\"}]}"]
	quest.273976CBCCAFDB80.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Справочник рецептов (JEI)\"}]}"
	quest.273976CBCCAFDB80.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Список предметов справа. R — рецепт предмета под курсором, U — где он используется. Поиск сверху: @mekanism — предметы мода.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В окне рецепта «+» переносит рецепт в верстак/терминал AE\"}, {\"text\": \"2.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ctrl+клик по рецепту в JEI с AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"-терминалом — заказать автокрафт.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Звёздочка (закладки): Shift+A на предмете — закрепить его в списке.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Если предмета нет в JEI — он скрыт специально (не нужен в сборке).\"}]}"]
	quest.4A1DC65847DBC1AF.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Что такое Immersive Engineering\"}]}"
	quest.4A1DC65847DBC1AF.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Immersive Engineering (IE) — мод «тяжёлой промышленности» в стиле \"}, {\"text\": \"1900\", \"color\": \"#E0C8FF\"}, {\"text\": \"-х: коксовые и доменные печи, дробилки, провода на столбах.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Главная идея — мультиблоки: строишь из блоков фигуру по схеме (смотри руководство IE «Инженерный справочник») и бьёшь по нужному блоку молотом инженера. Фигура «собирается» в одну машину.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В нашей сборке IE даёт сталь, кокс и пластины — без них не сделать первые машины Industrial Upgrade и Mekanism.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Справочник IE (книга «Инженерный справочник») делается из книги и железа — в нём схемы всех мультиблоков.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия IE — FE (Flux). Провода IE тянутся по воздуху между разъёмами: медный LV, электрум MV, сталь HV.\"}]}"]
	quest.2EBA076B0BE750B8.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Железная руда\"}]}"
	quest.2EBA076B0BE750B8.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Железо — основа всего. Копай под землёй: руда железа встречается в обычном камне и глубинном сланце.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сырое железо переплавь в печи в слиток. Позже машины будут давать из одной руды \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" слитков, так что руду можно копить, не плавя.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: возьми сразу \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" стака угля — печи, генераторы и кокс его едят много.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ступени добычи в сборке: кирка → дрель IU → цифровой шахтёр Mekanism → лазерный бур IF.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Плавь руду в печи только в начале — уже дробитель IU удваивает выход.\"}]}"]
	quest.44BC16D77AC07609.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Медь\"}]}"
	quest.44BC16D77AC07609.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Медь идёт на провода и кабели — без неё не передать энергию от генератора к машине.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Медная руда часто лежит выше железной. Переплавь в слитки.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Медь также нужна бронзе (\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" меди + \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" олово), электросхемам и тепловому генератору.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Медные провода IU режутся кусачками из медной пластины.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже медь даёт и SAG-мельница, и переработка Mekanism ×\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"…×\"}, {\"text\": \"5.\", \"color\": \"#E0C8FF\"}]}"]
	quest.32EF6B068D15CC53.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Олово\"}]}"
	quest.32EF6B068D15CC53.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Олово (руда из Mekanism) — для оловянных кабелей, жести, капсул для жидкостей и аккумуляторов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Бронза = медь + олово: из неё гаечный ключ и детали первых машин.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Жесть (оловянная пластина) — капсулы, кожухи, улучшения машин.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Оловянный кабель IU держит только \"}, {\"text\": \"32 EU/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" — для генератора и батбокса этого хватает.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Олово встречается рядом с медью на средних высотах.\"}]}"]
	quest.49F2E15ACBBEFF33.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Осмий\"}]}"
	quest.49F2E15ACBBEFF33.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Осмий — фирменный металл Mekanism. Синеватая руда, встречается довольно часто.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Без осмия не собрать ни одну машину Mekanism и даже тепловой генератор — лучший стартовый генератор сборки.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Осмий идёт и в слитки, и в универсальные кабели Mekanism, и в пропитанный сплав (осмий + редстоун в заполнителе).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: сразу положи в сундук \"}, {\"text\": \"64\", \"color\": \"#E0C8FF\"}, {\"text\": \" осмия — тепловой генератор, корпус, заполнитель и обогатитель съедят их быстро.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже осмий удваивается обогатителем, как любая руда.\"}]}"]
	quest.4DE4FA543230DF2A.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Молот инженера\"}]}"
	quest.4DE4FA543230DF2A.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Молот IE делается на верстаке. Два применения:\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \") В сетке верстака: слиток + молот → пластина. Молот при этом не тратится полностью — теряет прочность.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \") ПКМ молотом по собранной из блоков фигуре превращает её в мультиблок (коксовая печь, доменная печь и т.д.).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ещё молотом поворачивают и настраивают стороны некоторых блоков IE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Молот чинится на наковальне или делается заново — он дешёвый.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пластины молотом IE и молотом IU одинаковые.\"}]}"]
	quest.6CCE8C843CFF2AF3.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Железные пластины\"}]}"
	quest.6CCE8C843CFF2AF3.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пластины — главный полуфабрикат первых часов: из них корпуса машин, инструменты, шестерни.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пока делай молотом в верстаке. Позже металлоформер или прокатный стан IU будут штамповать их автоматически и без износа инструмента.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Медные, золотые, бронзовые, свинцовые пластины делаются так же.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Корпус машины IU = \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" железных пластин; на старте нужно \"}, {\"text\": \"20\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"30\", \"color\": \"#E0C8FF\"}, {\"text\": \" пластин.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Плотные пластины (\"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" пластин в компрессоре) — деталь поздних рецептов.\"}]}"]
	quest.5BA2B50281B37B21.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Коксовая печь\"}]}"
	quest.5BA2B50281B37B21.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Первый мультиблок. Скрафти \"}, {\"text\": \"27\", \"color\": \"#E0C8FF\"}, {\"text\": \" кирпичей коксовой печи, поставь куб \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" и ударь молотом по центру передней стороны.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Положи уголь — печь медленно (без энергии) превращает его в кокс и даёт креозот (жидкое топливо, пригодится позже).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Кокс нужен доменной печи для стали. Печь работает сама — поставь её сразу и забудь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Креозот сливается из печи в ведро или трубой IE — это топливо и пропитка для дерева IE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Поставь \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" печи рядом — кокса нужно много (сталь, генераторы).\"}]}"]
	quest.5BCB1DDFB39AF6BE.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Сталь\"}]}"
	quest.5BCB1DDFB39AF6BE.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Доменная печь: куб \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" из огнеупорных кирпичей, удар молотом. Железо + кокс → сталь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сталь нужна корпусам машин Mekanism, стальным деталям IE и многим рецептам сборки. Копи её — уходит быстро.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже сталь можно делать быстрее в металлургическом заполнителе Mekanism.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Доменная печь работает без энергии, но медленно. Улучшенная доменная печь IE (с энергией) быстрее.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В JEI сталь Mekanism и IE взаимозаменяемы (тег c:ingots/steel).\"}]}"]
	quest.20650AE597A021DF.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Алюминий и никель\"}]}"
	quest.20650AE597A021DF.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Руды IE. Алюминий — для лёгких деталей и сплавов, никель — для генератора Oritech и константана (медь + никель) для термоэлектрогенератора.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Обе руды встречаются и в глубинном сланце.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Константан (медь + никель) — в сплавочной печи IE/IU или в дуговой печи.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Алюминий-литиевый сплав нужен литиевому аккумулятору IU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Никель ещё входит в генератор Oritech.\"}]}"]
	quest.4CD1112BFC988674.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Дробилка IE\"}]}"
	quest.4CD1112BFC988674.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Большой мультиблок из стальных лесов, лёгких и тяжёлых инженерных блоков (схема — в справочнике IE). Ест энергию FE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Руда → \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" пыли (удвоение). Пыль плавится в печи в слиток.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Если лень строить — то же умеет дробитель Industrial Upgrade.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дробилка IE даёт бонусные пыли с шансом (например, из золотой руды — пыль с шансом серебра).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Мультиблок собирается молотом по центральному блоку; ЛКМ по нему показывает схему.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергию подключай к разъёму питания (красный блок) проводом IE.\"}]}"]
	chapter.61B662991AF44936.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Industrial Upgrade\"}]}"
	quest.5ECA7ECBAE5CA34E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Что такое Industrial Upgrade\"}]}"
	quest.5ECA7ECBAE5CA34E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Industrial Upgrade (IU) — продолжение легендарного IndustrialCraft \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" (IC\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"). Основная линия нашей сборки идёт через него, как у LoliLand.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия IU — EU. У каждой машины есть допустимое напряжение: НН (LV) \"}, {\"text\": \"32 EU/т\", \"color\": \"#E0C8FF\"}, {\"text\": \", СН (MV) \"}, {\"text\": \"128,\", \"color\": \"#E0C8FF\"}, {\"text\": \" ВН (HV) \"}, {\"text\": \"512,\", \"color\": \"#E0C8FF\"}, {\"text\": \" СВН (EV) \"}, {\"text\": \"2048.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Главная опасность: если подать машине напряжение выше допустимого — она ВЗРЫВАЕТСЯ. Между мощным источником и слабой машиной ставь трансформатор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машины улучшаются платами-улучшениями: ускоритель, трансформатор, накопитель, выталкиватель, затягиватель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Почти все машины IU ставят выход в ЛЮБУЮ соседнюю «принимающую» сторону, только если стоит выталкиватель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Гаечный ключ IU снимает машины без потери (простой ПКМ киркой может выронить машину без начинки).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергию IU и FE можно переводить конвертером Power Utilities: \"}, {\"text\": \"1 EU\", \"color\": \"#E0C8FF\"}, {\"text\": \" = \"}, {\"text\": \"4 FE\", \"color\": \"#E0C8FF\"}, {\"text\": \".\"}]}"]
	quest.5447CC13B784E48B.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Кузнечный молот\"}]}"
	quest.5447CC13B784E48B.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Инструмент для сетки верстака: слиток + молот → пластина. Молот остаётся в сетке и теряет \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" прочность за крафт (всего \"}, {\"text\": \"80\", \"color\": \"#E0C8FF\"}, {\"text\": \").\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сломался — сделай новый или почини на наковальне железным слитком.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пластины IU и пластины IE взаимозаменяемы в большинстве рецептов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Молот бывает и обсидиановым (\"}, {\"text\": \"240\", \"color\": \"#E0C8FF\"}, {\"text\": \" использований) — для особых руд.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: держи \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" молота в сундуке, на старте пластин нужно много.\"}]}"]
	quest.08CF9FE830856DD6.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Кусачки\"}]}"
	quest.08CF9FE830856DD6.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Режут пластину в провода: медная пластина + кусачки → медный провод. Остаются в сетке, прочность \"}, {\"text\": \"60.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Чинятся на наковальне железом.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Изоляция кабеля делается отдельно: провод + резина.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже металлоформер ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" режет провода автоматически.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Медные, золотые, оловянные и железные провода режутся одинаково.\"}]}"]
	quest.235DB8EE52D1D3A4.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Краник\"}]}"
	quest.235DB8EE52D1D3A4.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Найди каучуковое дерево (гевею) — у него на стволе бывают рыжие пятна смолы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"ПКМ краником по пятну → липкая смола. Пятно потом снова «нарастает».\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Деревянный краник хрупкий (\"}, {\"text\": \"16\", \"color\": \"#E0C8FF\"}, {\"text\": \" использований). Есть железный, медный, золотой, алмазный и незеритовый — смотри ветку «Жидкости и каучук».\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Посади саженцы каучукового дерева рядом с базой — смола нужна постоянно.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Смола выпадает рядом с деревом — подними её.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каучуковые деревья растут из саженцев, их можно рубить топором как обычные.\"}]}"]
	quest.705B8F26CA520563.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Резина\"}]}"
	quest.705B8F26CA520563.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Смолу переплавь в печи — получится резина. Экстрактор IU даёт из смолы больше резины.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Резина — изоляция кабелей и детали машин. Без изоляции кабель бьёт током и теряет энергию.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Резина также нужна для изоляции кабелей, резиновых сапог и деталей машин.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Экстрактор IU даёт \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" резины из \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" смолы (печь — только \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \").\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Автоматизация: ферма каучука → экстрактор ×\"}, {\"text\": \"6.\", \"color\": \"#E0C8FF\"}]}"]
	quest.4573E924CC60CD4F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Изолированный медный кабель\"}]}"
	quest.4573E924CC60CD4F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Медный провод (кусачки) + резина = изолированный медный кабель. Он проводит EU до \"}, {\"text\": \"128 EU/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" (СН).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Кабели тянутся от генератора к машинам. Каждый блок кабеля чуть-чуть теряет энергию — не делай линии длиной в сотни блоков, ставь хранилище ближе к машинам.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Оловянный кабель — для слабых токов (\"}, {\"text\": \"32 EU/т\", \"color\": \"#E0C8FF\"}, {\"text\": \"), золотой — для ВН.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Кабели одного вида соединяются сами; кабели разных видов тоже соединяются.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Если машина не получает энергию — проверь, что кабель «касается» её стороной (видно по отростку).\"}]}"]
	quest.7D42340CD01CFC9F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Электросхема\"}]}"
	quest.7D42340CD01CFC9F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Мозг любой машины IU. Верстак: изолированные кабели, редстоун и железная пластина.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Схемы уходят десятками — когда появится автокрафт AE\"}, {\"text\": \"2,\", \"color\": \"#E0C8FF\"}, {\"text\": \" поставь их на поток.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшенная электросхема = электросхема + редстоун + светокамень + лазурит.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Схемы Mekanism (basic/advanced/elite/ultimate) — это ДРУГИЕ схемы, они не заменяют схемы IU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Плата т\"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" нашей сборки — своя ветка (Кристаллы и переработка).\"}]}"]
	quest.4A9CB22B1AA0B777.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Корпус машины\"}]}"
	quest.4A9CB22B1AA0B777.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Блок-основа всех машин IU: \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" железных пластин по кругу.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Почти каждая машина = корпус + схема + «своя» деталь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшенный корпус — для мощных машин (ветка дальше).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Корпус можно ставить блоком, но толку от него нет — это деталь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: сделай сразу \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" корпусов, первых машин много.\"}]}"]
	quest.74A465DE14F03163.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Генератор\"}]}"
	quest.74A465DE14F03163.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Первая энергия IU. Сжигает уголь, дерево, кокс — всё, что горит в печи — и выдаёт \"}, {\"text\": \"10 EU/т\", \"color\": \"#E0C8FF\"}, {\"text\": \".\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Как подключить: генератор → кабель → машина (или хранилище). Генератор не хранит много энергии, без потребителя он просто стоит полный.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ступень «Старт» лестницы генераторов. Дальше — геотермальный (лава), тепловой Mekanism и солнечные панели.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Генератор хранит немного EU и «стоит», когда некуда отдавать — это нормально.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Уголь: \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" штука ≈ \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000 EU\", \"color\": \"#E0C8FF\"}, {\"text\": \". Лучше кокс или блоки угля.\"}]}"]
	quest.712D0FA76F731BF4.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Дробитель\"}]}"
	quest.712D0FA76F731BF4.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Руда → \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" пыли, пыль в печи → слиток. Удваивает добычу с каждой руды.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Питание: НН (до \"}, {\"text\": \"32 EU/т\", \"color\": \"#E0C8FF\"}, {\"text\": \"). Вставь руду сверху, забери пыль снизу/сбоку (или поставь выталкиватель).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дробит ещё и камень в гравий/песок, уголь в угольную пыль.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дробитель удваивает железо, медь, олово, золото, свинец, серебро и т.д.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Поставь затягиватель (берёт из сундука) и выталкиватель (кладёт в печь) — вот и первая линия.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ускоритель повышает скорость, но и расход энергии.\"}]}"]
	quest.016E69D450231DCD.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Компрессор\"}]}"
	quest.016E69D450231DCD.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сжимает: \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" предметов → блок, пыль → пластины, угольную ткань → углепластик, энергиевую пыль → энергокристалл.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Тоже НН. Одна из самых используемых машин IU — сделай сразу.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Компрессор делает и плотные пластины (\"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" пластин), и сжатый уголь для алмазов IU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Для автоматизации — затягиватель/выталкиватель или шины AE\"}, {\"text\": \"2.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже — компрессор ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \"/×\"}, {\"text\": \"12\", \"color\": \"#E0C8FF\"}, {\"text\": \" (ветка «Машины ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" и ×\"}, {\"text\": \"12\", \"color\": \"#E0C8FF\"}, {\"text\": \"»).\"}]}"]
	quest.0437BBD04D5DD09F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Экстрактор\"}]}"
	quest.0437BBD04D5DD09F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выжимает: смола → больше резины, чем в печи; саженцы и бревна каучука → резина.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Также достаёт содержимое из капсул и делает некоторые детали.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Также извлекает селитру/пыли из некоторых блоков (смотри JEI).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже — экстрактор ×\"}, {\"text\": \"6.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Питание НН.\"}]}"]
	quest.67EA7F089724FBC2.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Электропечь\"}]}"
	quest.67EA7F089724FBC2.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Печь на энергии: плавит быстрее обычной и без топлива. Хорошая пара к дробителю: дробитель → электропечь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Работает на НН (\"}, {\"text\": \"32 EU/т\", \"color\": \"#E0C8FF\"}, {\"text\": \").\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже — печь ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \"/×\"}, {\"text\": \"12\", \"color\": \"#E0C8FF\"}, {\"text\": \" Maelstrom Tech.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ускорители работают и в электропечи.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: ставь печь вплотную к дробителю с выталкивателем — пыль сразу плавится.\"}]}"]
	quest.1A731C5D6F3A0FBC.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Ускоритель\"}]}"
	quest.1A731C5D6F3A0FBC.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Плата-улучшение. Вставь в слот улучшений машины (справа в окне): машина работает быстрее, но ест больше энергии.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Можно ставить несколько. Если энергии не хватает — машина работает рывками, тогда добавь генераторов или «Энергохранитель».\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшение «Трансформатор» поднимает допустимое напряжение машины на ступень — спасает от взрыва при подключении к ВН.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергохранитель — улучшение буфера машины: машина копит энергию на «пиковые» операции.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшения переносятся: вынул из одной машины — вставил в другую.\"}]}"]
	quest.43573DFF9AC4AE77.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Выталкиватель и затягиватель\"}]}"
	quest.43573DFF9AC4AE77.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выталкиватель сам выкладывает готовое в соседний сундук/трубу/машину. Затягиватель сам берёт сырьё из соседнего сундука.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сторону можно выбрать: ПКМ улучшением в руке по нужной стороне или настройка в окне машины.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Есть жидкостные версии — для машин с баками (выталкиватель/затягиватель жидкостей).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"С ними линия «сундук → дробитель → печь → сундук» работает без труб.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выталкиватель не тянет из машины — только кладёт. Затягиватель не кладёт — только берёт.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Можно ставить и в генератор (затягиватель берёт уголь из сундука).\"}]}"]
	quest.047814C97E70A128.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Улучшенная электросхема\"}]}"
	quest.047814C97E70A128.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Электросхема + редстоун + светокамень + лазурит. Нужна машинам второго ряда и хранилищам MFE/MFSU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ещё это «гейт» ранних генераторов Powah — значит, ты уже вышел из совсем стартовой ступени.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшенные схемы нужны также лазуротрону, MFSU, генератору материи.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"На автокрафт AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" их стоит поставить одними из первых.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Светокамень — из Незера; на старте возьми сразу стак.\"}]}"]
	quest.4C6AC41A4E55F9BE.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Улучшенный корпус\"}]}"
	quest.4C6AC41A4E55F9BE.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Корпус + композит + улучшенные схемы + сталь. Основа мощных машин IU: генератора материи, молекулярного преобразователя, центрифуги.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Композит (улучшенный сплав) — сплавной слиток IU, сжатый в компрессоре.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Композит: сплавной слиток (железо + бронза + олово) в компрессоре.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Углепластик: угольная пыль → углеволокно → углеткань → компрессор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшенный корпус ставится как блок в некоторых мультиблоках IU.\"}]}"]
	quest.637AB49AE0BD46ED.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Термоцентрифуга\"}]}"
	quest.637AB49AE0BD46ED.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Очищенная руда → пыль + редкие металлы (побочный продукт). Нагревается перед работой — первые секунды стоит.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пара к промывателю руд: промывка + центрифуга дают больше, чем дробитель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Без нагрева центрифуга не работает — дай ей постоянное питание.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Промыватель руд IU: дроблёная руда + вода → очищенная руда.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Связка промыватель → центрифуга ≈ ×\"}, {\"text\": \"2 с\", \"color\": \"#E0C8FF\"}, {\"text\": \" бонусами.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже переработка Mekanism ×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" выгоднее.\"}]}"]
	quest.3A1D2B5A5388002A.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Прокатный стан\"}]}"
	quest.3A1D2B5A5388002A.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Автоматические пластины и кожухи из слитков — молот больше не нужен.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Поставь на линию с затягивателем: сундук слитков → стан → сундук пластин.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Прокатный стан стоит на «примитивной» станине (поршень, доски) — его можно сделать рано.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже — металлоформер ×\"}, {\"text\": \"6.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Питание НН.\"}]}"]
	quest.7515E50DFEF02CEE.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Дробитель ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}]}"
	quest.7515E50DFEF02CEE.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машина Maelstrom Tech по образцу LoliLand: шесть операций IU сразу, ~\"}, {\"text\": \"15 с\", \"color\": \"#E0C8FF\"}, {\"text\": \" на цикл, на \"}, {\"text\": \"20%\", \"color\": \"#E0C8FF\"}, {\"text\": \" меньше FE за операцию.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: дробитель IU + ниобий, модуль, корпус, сплав Mekanism и плата т\"}, {\"text\": \"1.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Питание FE (не EU!) — от универсального кабеля Mekanism, Powah и т.п. Входы/выходы — с любой стороны, ставь сундуки/трубы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Режимы (кнопка в окне) переключают тип работы, если машина умеет несколько.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машина работает только на FE — подключи кабель Mekanism/Powah/Flux.\"}]}"]
	quest.448652871CF34494.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Печь ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}]}"
	quest.448652871CF34494.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Шесть плавок параллельно. Пара к дробителю ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \": руда → пыль → слиток в \"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" потоков.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Питание FE. Вход/выход — любые стороны.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь затягиватель/шины AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" для автоматики.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшение скорости Maelstrom ускоряет.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дальше — печь ×\"}, {\"text\": \"12.\", \"color\": \"#E0C8FF\"}]}"]
	quest.60F7797F14F9C038.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Компрессор ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}]}"
	quest.60F7797F14F9C038.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепты компрессора IU в \"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" потоков: пластины, блоки, углепластик, энергокристаллы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Питание FE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Шесть потоков — для массовых пластин и блоков.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшение скорости Maelstrom ускоряет.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дальше — компрессор ×\"}, {\"text\": \"12.\", \"color\": \"#E0C8FF\"}]}"]
	quest.41E925CD6E26EF67.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Экстрактор ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}]}"
	quest.41E925CD6E26EF67.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепты экстрактора IU в \"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" потоков — резина с фермы каучука.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Питание FE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пара к ферме каучука: бревна → резина.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшение скорости Maelstrom ускоряет.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дальше — экстрактор ×\"}, {\"text\": \"12.\", \"color\": \"#E0C8FF\"}]}"]
	quest.4187902D4B860F98.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Металлоформер ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}]}"
	quest.4187902D4B860F98.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пластины, провода и кожухи в \"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" потоков — замена молоту, кусачкам и прокатному стану.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Питание FE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Режимы: прокатка (пластины), резка (провода), экструзия (кожухи) — кнопка в окне.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшение скорости Maelstrom ускоряет.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дальше — металлоформер ×\"}, {\"text\": \"12.\", \"color\": \"#E0C8FF\"}]}"]
	quest.66A7D1CDA915357F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Дробитель ×\"}, {\"text\": \"12\", \"color\": \"#E0C8FF\"}]}"
	quest.66A7D1CDA915357F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Второй тир: дробитель ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" + совершенные детали. Ещё больше параллельных операций и быстрее цикл.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Аналогично есть печь, компрессор, экстрактор и металлоформер ×\"}, {\"text\": \"12.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшение скорости Maelstrom повышает приём энергии и ускоряет.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Питание FE — нужна энергетика среднего уровня и выше.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь рядом с печью ×\"}, {\"text\": \"12\", \"color\": \"#E0C8FF\"}, {\"text\": \" — одна линия на всю добычу.\"}]}"]
	quest.0CF8A692176F512C.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Молекулярный преобразователь\"}]}"
	quest.0CF8A692176F512C.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машина из Advanced Solar Panels/LoliLand: превращает один предмет в другой, тратя огромную энергию. Нужна для санариума — без неё нет гибридной панели.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Крафт: \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" улучшенных корпуса, \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" платы т\"}, {\"text\": \"2,\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" СВН-трансформатора и ядро телепортации Mekanism в центре.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергию берёт EF/FE из любого кабеля IU или Mekanism (\"}, {\"text\": \"1 EF\", \"color\": \"#E0C8FF\"}, {\"text\": \" = \"}, {\"text\": \"4 FE\", \"color\": \"#E0C8FF\"}, {\"text\": \"). Время операции = нужная энергия / мощность подачи.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пример: санариум — \"}, {\"text\": \"36 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE. От \"}, {\"text\": \"20 тыс.\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE/т — \"}, {\"text\": \"90 с\", \"color\": \"#E0C8FF\"}, {\"text\": \", от \"}, {\"text\": \"100 тыс.\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE/т — \"}, {\"text\": \"18 с\", \"color\": \"#E0C8FF\"}, {\"text\": \". Солнечные панели Mekanism его не потянут.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Источник — индукционная матрица, реактор Powah или куб энергии с быстрым кабелем. Подключай напрямую к накопителю, а не к слабому генератору.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Автоматизация: воронка/труба сверху кладёт вход, снизу забирает выход. Список превращений — в JEI на самой машине.\"}]}"]
	quest.59139A26FDD9698A.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Частица санариума\"}]}"
	quest.59139A26FDD9698A.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Светопыль → частица санариума за \"}, {\"text\": \"4 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE (от \"}, {\"text\": \"20 тыс.\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE/т — \"}, {\"text\": \"10 с\", \"color\": \"#E0C8FF\"}, {\"text\": \").\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Второй путь к энергизатору Powah: тот дешевле, но требует флюоритовую пыль и \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" светопыли на штуку.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Частицы идут в сотни рецептов IU и ядер LoliLand — держи запас.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Автоматизация: ME-экспорт светопыли в преобразователь, импорт частиц обратно.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Светопыль — из Незера или из светокамня в дробителе.\"}]}"]
	quest.323AD59315FABE92.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Иридий из железа\"}]}"
	quest.323AD59315FABE92.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Железный блок → кусок иридия за \"}, {\"text\": \"36 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE — как иридиевая руда из железа в LoliLand.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Это второй источник иридия кроме UU-материи (руда иридия в паке выключена).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Иридиевая пластина = \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" куска иридия: от \"}, {\"text\": \"100 тыс.\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE/т она обойдётся в ~\"}, {\"text\": \"72 с\", \"color\": \"#E0C8FF\"}, {\"text\": \" работы машины.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Иридий нужен для квантовых инструментов, совершенной и квантовой панелей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Железо дешёвое — упор только в энергию. Две-три машины параллельно — и иридий не дефицит.\"}]}"]
	quest.33D23D6D2FBDCFF1.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Звезда Незера без босса\"}]}"
	quest.33D23D6D2FBDCFF1.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Череп скелета-иссушителя → звезда Незера за \"}, {\"text\": \"16 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE (от \"}, {\"text\": \"20 тыс.\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE/т — \"}, {\"text\": \"40 с\", \"color\": \"#E0C8FF\"}, {\"text\": \").\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Один череп вместо трёх и без боя с иссушителем.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Черепа выпадают из скелетов-иссушителей в адских крепостях; меч с «Добычей» повышает шанс.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Звёзды нужны маякам и ряду поздних рецептов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ещё в машине: незерак → \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" пороха, песок → гравий (дёшево).\"}]}"]
	chapter.6AF521A5E89F8DCF.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Энергетика и генераторы\"}]}"
	quest.7CE7FA512F427214.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Энергия: EU и FE\"}]}"
	quest.7CE7FA512F427214.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В сборке два вида энергии. EU — у Industrial Upgrade. FE (она же RF) — у всех остальных: Mekanism, IE, Powah, Ender IO, AE\"}, {\"text\": \"2,\", \"color\": \"#E0C8FF\"}, {\"text\": \" Draconic, нашего мода.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Mekanism показывает энергию в джоулях (J): \"}, {\"text\": \"1 FE\", \"color\": \"#E0C8FF\"}, {\"text\": \" = \"}, {\"text\": \"2,5\", \"color\": \"#E0C8FF\"}, {\"text\": \" J. Его кабели принимают и EU, и FE — удобный «переходник».\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лестница генераторов: Старт (генератор IU, тепловой Mekanism, стартовые Powah) → Ранний (флюорит) → Средний (хризолит) → Поздний (плутоний, заряженный аметрин) → Эндгейм (термояд, реакторы Draconic и Powah).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Правило: генераторы ставь ПЛЮС хранилище. Хранилище сглаживает пики и не даёт энергии пропадать.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергию считает число FE/т (в тик; в секунде \"}, {\"text\": \"20\", \"color\": \"#E0C8FF\"}, {\"text\": \" тиков).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Хранилища: батбокс → CESU → MFE → MFSU (EU); энергокубы Mekanism, ячейки Powah, банки EIO (FE); индукционная матрица и энергоядро Draconic — эндгейм.\"}]}"]
	quest.75653975143FBC7F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Тепловой генератор\"}]}"
	quest.75653975143FBC7F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лучший стартовый генератор: жжёт любое топливо и ещё сам греется от лавы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Фишка: поставь вокруг него источники лавы (до \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" сторон) — каждый добавляет энергию без топлива. Внутрь можно залить лаву ведром.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выдаёт FE (в окне — в джоулях). Подключи универсальным кабелем Mekanism.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт простой: железо, доски, осмий, медь, печь — всё из первого часа.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лава вокруг должна быть ИСТОЧНИКАМИ, текущая лава не считается.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Генератор отдаёт энергию в любую сторону — кабели можно подвести сверху/снизу.\"}]}"]
	quest.5C9A513A3DB36F0E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Геотермальный генератор\"}]}"
	quest.5C9A513A3DB36F0E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лава → EU. Ведро лавы — много энергии. Можно заливать помпой из лавового озера — тогда энергия бесконечна.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Делается из генератора IU, стекла и вёдер.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Помпа + бак лавы рядом = генератор работает без тебя.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Квантовый запутыватель позволит возить лаву из Незера.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выход — НН, можно прямо в батбокс.\"}]}"]
	quest.0E305D5A42FDA556.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Аккумулятор\"}]}"
	quest.0E305D5A42FDA556.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Переносная батарейка EU. Заряжается в слоте зарядки хранилища, разряжается в слот энергии машины (иконка молнии).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужна для батбокса, ранцев и электроинструмента.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшенный (свинцовый) аккумулятор, энергокристалл и лазуротрон — следующие ёмкости.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжающие версии сами заряжают инвентарь (ветка инструментов IU).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряд виден в подсказке предмета.\"}]}"]
	quest.39FE718EA9D422CF.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Батбокс\"}]}"
	quest.39FE718EA9D422CF.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Первое хранилище EU (НН). Принимает энергию со всех сторон, а ОТДАЁТ только с одной — с точкой на корпусе.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Повернуть выход: гаечным ключом IU по нужной стороне.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Схема базы: генераторы → батбокс → машины. Генератор не простаивает, машины не голодают.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ёмкость батбокса небольшая — это буфер, не склад.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В слоты батбокса можно положить аккумулятор: верхний — зарядить, нижний — разрядить в батбокс.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дальше: CESU → MFE → MFSU.\"}]}"]
	quest.6B527037F798F89E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Трансформатор\"}]}"
	quest.6B527037F798F89E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Понижает или повышает напряжение. Вход по умолчанию — с \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" сторон (высокое напряжение), выход — с одной (низкое).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"ПКМ гаечным ключом — режим «повышать». Ставь между хранилищем СН/ВН и машинами НН, иначе машины взорвутся.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Трансформаторы бывают НН, СН, ВН, СВН.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ошибка: перевёрнутый трансформатор. Точка на корпусе = сторона НИЗКОГО напряжения (по умолчанию выход).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшение «трансформатор» в машине — альтернатива блоку.\"}]}"]
	quest.775AB13FCD68D1BD.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"CESU и MFE\"}]}"
	quest.775AB13FCD68D1BD.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Хранилища побольше: CESU (СН, на бронзе) и MFE (СН, на энергокристаллах).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Чем больше хранилище, тем выше его выходное напряжение — проверяй, что машины выдержат.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"CESU и MFE — СН (\"}, {\"text\": \"128 EU/т\", \"color\": \"#E0C8FF\"}, {\"text\": \"): машины НН рядом с ними — через трансформатор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выход хранилища настраивается ключом, вход — остальные стороны.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Режимы редстоуна (кнопка в окне) — сигнал при заполнении.\"}]}"]
	quest.125D53D683D7A3D9.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Флюоритовый кристалл\"}]}"
	quest.125D53D683D7A3D9.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Первый кристалл-тир энергетики. Добывай самоцветы флюорита (руда Mekanism) и обогащай: обогатитель Mekanism, \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" самоцвета → кристалл.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Флюорит открывает ступень «Ранний»: генераторы Powah basic, энергокубы Mekanism, банк конденсаторов Ender IO, ячейки Powah.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Тиры кристаллов: флюорит < хризолит < аметрин; каждый можно «зарядить» в энергизирующем орбе Powah.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Руда флюорита Mekanism бывает в обычном камне на средних глубинах.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пыль флюорита — дробилка IE или дробитель Mekanism.\"}]}"]
	quest.148A61F0C1EA4722.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Генераторы Powah\"}]}"
	quest.148A61F0C1EA4722.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Powah — мод генераторов по тирам: печной (furnator, топливо), магматический (лава), термо (тепло под ним), солнечная панель и реактор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Тиры: стартовый → базовый → закалённый → пылающий → ниотический → одухотворённый → нитро; каждый в разы мощнее.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь кабели Powah или Mekanism. Генераторы Powah сами отдают энергию в соседние блоки.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Магматический генератор берёт лаву из бака/ведра; печной — любое топливо.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Термо генератор работает от тепла блока ПОД ним (лава, магма, огонь).\"}]}"]
	quest.37AD199AC893C0C3.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Powah: базовые панели\"}]}"
	quest.37AD199AC893C0C3.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Базовые солнечная и термо-панель Powah — с флюоритом. Базовые печной и магматический — с улучшенной схемой IU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Термогенератор ставь НАД лавой или магмой и охлаждай: соседняя вода/лёд добавляют выработку.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Солнечная панель Powah работает только днём и под открытым небом.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Конденсаторы Powah — деталь всех тиров, делаются в энергизирующем орбе.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Следующий тир — hardened (хризолит).\"}]}"]
	quest.65097D6A6F21331D.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Энергокуб\"}]}"
	quest.65097D6A6F21331D.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Хранилище Mekanism. Стороны настраиваются конфигуратором Mekanism: синие — вход, оранжевые — выход.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Умеет заряжать предметы в слоте. Тиры: базовый (флюорит) → продвинутый → элитный → ультимативный.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергокуб можно носить: он сохраняет заряд в предмете.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжает предмет в верхнем слоте, разряжает — в нижнем.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ультимативный куб — с заряженным аметрином.\"}]}"]
	quest.705F7F73C3046095.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"MFSU\"}]}"
	quest.705F7F73C3046095.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Главное хранилище EU середины игры (ВН). MFE + лазуротроновый кристалл + улучшенный корпус.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Внимание: выход ВН \"}, {\"text\": \"512 EU/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" — машины НН/СН возле него только через трансформатор!\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"MFSU заряжает броню и инструменты в своих слотах.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лазуротрон: энергокристалл + лазурит + улучшенные схемы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дальше — индукционная матрица Mekanism или энергоядро Draconic.\"}]}"]
	quest.47FC54E3092CACE9.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Ветрогенератор\"}]}"
	quest.47FC54E3092CACE9.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ступень «Средний». Чем выше стоит — тем больше энергии (максимум ближе к потолку мира). Топлива не нужно.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт с хризолитом. Ставь грядкой на горе или высокой башне.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лопасти крутятся только если вокруг нет блоков (проверка простора).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В Незере и Краю ветра нет — генератор стоит.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Генераторы можно ставить рядом — друг другу не мешают.\"}]}"]
	quest.46925C3E8F875098.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Продвинутый солнечный\"}]}"
	quest.46925C3E8F875098.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Солнечный генератор Mekanism (старт, \"}, {\"text\": \"20 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" днём) ×\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" + хризолит = продвинутый (\"}, {\"text\": \"120 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \").\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ночью и в дождь не работает — нужен энергокуб.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь много штук на крыше, соединяй кабелем Mekanism в куб.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Солнечные генераторы Mekanism не работают в Незере.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дальше солнечная линия идёт через панели IU и лестницу LoliLand.\"}]}"]
	quest.76446326B9767EEA.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Flux Networks\"}]}"
	quest.76446326B9767EEA.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Беспроводная энергия всей базы. Флакс-пыль: брось редстоун на обсидиан, стоящий на бедроке.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Контроллер — сердце сети. Флакс-разъём (plug) забирает энергию от генератора, флакс-точка (point) отдаёт машине. Провода больше не нужны.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сеть одна на всю базу, работает между измерениями. Настраивается конфигуратором.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Флакс-хранилище подключается к сети и копит энергию всей сети.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Приоритеты: разъёмы/точки с большим приоритетом обслуживаются первыми.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Беспроводная зарядка игрока — опция контроллера.\"}]}"]
	quest.006BA0A32C36E7F2.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Ветряк IU\"}]}"
	quest.006BA0A32C36E7F2.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ступень «Старт». Бестопливный генератор: крутит ротор, который вставляешь в его слот. Без ротора не работает.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Мощность = сила ветра × высота × КПД ротора. Лучшая высота — Y=\"}, {\"text\": \"150\", \"color\": \"#E0C8FF\"}, {\"text\": \": ниже и выше выработка падает (на Y=\"}, {\"text\": \"64\", \"color\": \"#E0C8FF\"}, {\"text\": \" — меньше половины).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужен простор: перед лопастями — круг воздуха радиусом \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" блоков. Любой блок в круге — ротор стоит. В Незере и Краю ветра нет.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ветер общий для мира и меняется сам: от штиля до урагана. Направление тоже меняется — генератор, повёрнутый против ветра, даёт меньше.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Простой ветряк берёт роторы уровней \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \": деревянный, бронзовый, железный, стальной.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергию отдаёт в провода IU (EU); сеть IU принимает и FE.\"}]}"]
	quest.1B20C4899874A607.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Роторы IU\"}]}"
	quest.1B20C4899874A607.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лестница роторов: деревянный → бронзовый → железный → стальной → углеродный → иридиевый. Каждый следующий делается из прошлого.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"При ветре ~\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" м/с на Y=\"}, {\"text\": \"150\", \"color\": \"#E0C8FF\"}, {\"text\": \": деревянный ≈\"}, {\"text\": \"120 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \", бронзовый и железный ≈\"}, {\"text\": \"240,\", \"color\": \"#E0C8FF\"}, {\"text\": \" стальной ≈\"}, {\"text\": \"365.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ротор изнашивается — полоска прочности под иконкой. Чем сильнее ветер, тем чаще износ (раз в \"}, {\"text\": \"0,5\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"3 с\", \"color\": \"#E0C8FF\"}, {\"text\": \").\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Хватает: деревянного ≈\"}, {\"text\": \"3 ч\", \"color\": \"#E0C8FF\"}, {\"text\": \", железного ≈\"}, {\"text\": \"1,5\", \"color\": \"#E0C8FF\"}, {\"text\": \" суток, стального ≈\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" суток работы при среднем ветре.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Бронзовый — из деревянного, стальной — из железного. Пластины — с молота или пресса IE.\"}]}"]
	quest.2B2D7856FC92F058.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Продвинутый ветряк IU\"}]}"
	quest.2B2D7856FC92F058.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ступень «Средний». Простой ветряк + стальные пластины, хризолит и улучшенные схемы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Берёт роторы уровней \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \": углеродный, иридиевый и первые роторы Maelstrom (хризолитовый, аметриновый).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Формула та же: высота Y=\"}, {\"text\": \"150,\", \"color\": \"#E0C8FF\"}, {\"text\": \" круг воздуха радиусом \"}, {\"text\": \"5,\", \"color\": \"#E0C8FF\"}, {\"text\": \" ветер в лоб.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь ветряки в ряд на высокой башне — друг другу не мешают, если круги лопастей не пересекаются.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергию копи в MFSU или энергокубе: ветер то стихает, то усиливается.\"}]}"]
	quest.6BFB399E7B7E3E45.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Иридиевый ротор\"}]}"
	quest.6BFB399E7B7E3E45.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Углеродный ротор (из стального + углепластик) ≈\"}, {\"text\": \"490 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \", иридиевый (из углеродного + иридиевые пластины) ≈\"}, {\"text\": \"970 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \".\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Иридия в мире нет — только лазерный бур IF (белая линза) и побочка дробилки IE с сырого золота.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Углеродный служит ≈\"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" суток, иридиевый ≈\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" суток при среднем ветре.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Иридиевый — последний ротор IU. Выше — роторы Maelstrom Tech.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Автоматизация: слот ротора принимает роторы трубой или воронкой. Держи запас в сундуке с воронкой над ветряком: изношенный вынь — новый встанет сам.\"}]}"]
	quest.4DAABB64510C69F7.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Хризолитовый ротор\"}]}"
	quest.4DAABB64510C69F7.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ступень «Средний». Первый ротор Maelstrom Tech: иридиевый ротор + хризолит + иридиевые пластины.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"КПД \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" — вдвое больше иридиевого: ≈\"}, {\"text\": \"1950 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" при ветре ~\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" м/с на Y=\"}, {\"text\": \"150.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Уровень \"}, {\"text\": \"7\", \"color\": \"#E0C8FF\"}, {\"text\": \" — ставится в продвинутый ветряк.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Прочность \"}, {\"text\": \"200\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000\", \"color\": \"#E0C8FF\"}, {\"text\": \" — около \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" суток работы при среднем ветре.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каждый следующий ротор Maelstrom: КПД ×\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" и прочность ×\"}, {\"text\": \"2.\", \"color\": \"#E0C8FF\"}]}"]
	quest.43CDC32B6DE53735.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Аметриновый ротор\"}]}"
	quest.43CDC32B6DE53735.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Хризолитовый ротор + заряженный аметрин + атомный сплав Mekanism.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"КПД \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \": ≈\"}, {\"text\": \"3900 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" при ветре ~\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" м/с на Y=\"}, {\"text\": \"150.\", \"color\": \"#E0C8FF\"}, {\"text\": \" Уровень \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" — последний для продвинутого ветряка.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Прочность \"}, {\"text\": \"400\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000\", \"color\": \"#E0C8FF\"}, {\"text\": \" — около \"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" суток работы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дальше нужен улучшенный ветряк IU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Старый хризолитовый ротор уходит в рецепт — поставь в продвинутый ветряк запасной, пока крафтишь новый.\"}]}"]
	quest.2FEC495DA829AA82.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Улучшенный ветряк IU\"}]}"
	quest.2FEC495DA829AA82.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ступень «Поздний». Продвинутый ветряк + заряженный аметрин, иридиевые пластины и плутоний.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Берёт роторы уровней \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"11\", \"color\": \"#E0C8FF\"}, {\"text\": \": квантовый, пустотный, сингулярный (Maelstrom Tech).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Роторы ниже \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \"-го уровня в него не встают — держи продвинутые ветряки для них.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Буфер ветряка — \"}, {\"text\": \"500\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000 EU\", \"color\": \"#E0C8FF\"}, {\"text\": \": подключай провод IU сразу к хранилищу.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Простор тот же: круг воздуха радиусом \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" перед лопастями, лучшая высота Y=\"}, {\"text\": \"150.\", \"color\": \"#E0C8FF\"}]}"]
	quest.38E2233895CBED66.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Квантовый ротор\"}]}"
	quest.38E2233895CBED66.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Аметриновый ротор + квантовые ядра + плутоний.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"КПД \"}, {\"text\": \"16\", \"color\": \"#E0C8FF\"}, {\"text\": \": ≈\"}, {\"text\": \"7800 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" при ветре ~\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" м/с на Y=\"}, {\"text\": \"150.\", \"color\": \"#E0C8FF\"}, {\"text\": \" Уровень \"}, {\"text\": \"9.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Прочность \"}, {\"text\": \"800\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000\", \"color\": \"#E0C8FF\"}, {\"text\": \" — около \"}, {\"text\": \"20\", \"color\": \"#E0C8FF\"}, {\"text\": \" суток работы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Десяток таких ветряков заменяет реактор деления — без топлива и отходов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ветряки ставь на разной высоте не нужно: все на Y=\"}, {\"text\": \"150,\", \"color\": \"#E0C8FF\"}, {\"text\": \" рядом, с непересекающимися кругами лопастей.\"}]}"]
	quest.2C60A43EF1B321C0.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Пустотный и сингулярный роторы\"}]}"
	quest.2C60A43EF1B321C0.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ступень «Эндгейм». Пустотный ротор: квантовый + ядра виверны + дисперсионные ядра. КПД \"}, {\"text\": \"32\", \"color\": \"#E0C8FF\"}, {\"text\": \" (≈\"}, {\"text\": \"15\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"500 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \"), уровень \"}, {\"text\": \"10.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сингулярный ротор: пустотный + пробуждённые ядра + гравитомагнитные ядра. КПД \"}, {\"text\": \"64\", \"color\": \"#E0C8FF\"}, {\"text\": \" (≈\"}, {\"text\": \"31\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \"), уровень \"}, {\"text\": \"11\", \"color\": \"#E0C8FF\"}, {\"text\": \" — вершина ветра.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В ураган выработка в \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" раз выше, в штиль — почти ноль: ставь рядом хранилище.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Прочность \"}, {\"text\": \"1,6 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" и \"}, {\"text\": \"3,2 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" — недели работы, но в ураган износ в \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" раз быстрее.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Запасной ротор в сундуке с воронкой над ветряком — и ветряк сам продолжит работу после замены.\"}]}"]
	chapter.59809423D2DDAA41.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Жидкости и каучук\"}]}"
	quest.41EB4E5574027484.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Жидкости: вёдра, капсулы, баки\"}]}"
	quest.41EB4E5574027484.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Жидкости носят в вёдрах (\"}, {\"text\": \"1000\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ), капсулах IU и баках. Машины сами пьют из труб — трубы Mekanism (механические) или IE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Капсулы удобнее вёдер: стакаются по \"}, {\"text\": \"64,\", \"color\": \"#E0C8FF\"}, {\"text\": \" даже заполненные одной жидкостью.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Чтобы не потерять жидкость: заливай/сливай капсулы по одной (ПКМ одной капсулой). Машины IU и Mekanism тоже берут по одной.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Жидкость в JEI: наведи на жидкость в окне машины и нажми R — увидишь, как её получить.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Механические трубы Mekanism: базовые медленные, ультимативные очень быстрые; режим «вытягивать» ставится конфигуратором.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Капсулы IU не стоит выкидывать в лаву — сгорят.\"}]}"]
	quest.72FCEB758F965FF3.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Универсальная капсула\"}]}"
	quest.72FCEB758F965FF3.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Жесть + стеклянная панель → \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" капсулы. Вмещает \"}, {\"text\": \"1000\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ любой жидкости.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"ПКМ по источнику воды/лавы — набрать, ПКМ по месту — вылить. В машинах IU кладётся в слот капсулы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Малая капсула (\"}, {\"text\": \"500\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ) дешевле, усиленная (\"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ) — для больших объёмов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В машинах IU слот капсулы обычно сверху/слева — смотри окно.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Капсулы лучше хранить пустыми в сундуке и наполнять по мере нужды.\"}]}"]
	quest.46D28737B613609E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Металлические краники\"}]}"
	quest.46D28737B613609E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Деревянный краник ломается за \"}, {\"text\": \"16\", \"color\": \"#E0C8FF\"}, {\"text\": \" сборов. Железный — \"}, {\"text\": \"128,\", \"color\": \"#E0C8FF\"}, {\"text\": \" медный — \"}, {\"text\": \"96,\", \"color\": \"#E0C8FF\"}, {\"text\": \" золотой — \"}, {\"text\": \"64,\", \"color\": \"#E0C8FF\"}, {\"text\": \" алмазный — \"}, {\"text\": \"400,\", \"color\": \"#E0C8FF\"}, {\"text\": \" незеритовый — \"}, {\"text\": \"960\", \"color\": \"#E0C8FF\"}, {\"text\": \" и не горит в лаве.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Работают так же: ПКМ по пятну смолы. Чинятся на наковальне своим материалом.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Незеритовый — в столе кузнеца: алмазный краник + незеритовый слиток + шаблон.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Золотой краник самый хрупкий из металлических, незеритовый — самый прочный.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ферма EIO краники не использует (см. «Ферма каучука»).\"}]}"]
	quest.2A413F679E563D4B.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Ферма каучука\"}]}"
	quest.2A413F679E563D4B.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Автоматический каучук: фермерская станция Ender IO сажает и рубит каучуковые деревья.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Краники ферма не использует. Резину даёт переработка: бревна каучука → экстрактор IU (резина) или жидкостный экстрактор Industrial Foregoing (латекс).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Станции нужна энергия FE, мотыга/топор в слотах инструментов и саженцы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь фермерскую станцию в центре квадрата \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" (радиус настраивается).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Удобрение (костная мука) в слотах ускоряет рост.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выход бревен — в сундук рядом или трубой EIO.\"}]}"]
	quest.54B54C39FE19AD5A.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Бак Mekanism\"}]}"
	quest.54B54C39FE19AD5A.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Хранит одну жидкость. Ставь баки друг на друга — жидкость перетекает вниз.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Режим «самосвал» (кнопка в окне) — сливает лишнее. В руке бак работает как большое ведро.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Тиры бака: базовый → продвинутый → элитный → ультимативный → творческий (нет в выживании).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ведро в слот бака — залить/слить вручную.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Бак сохраняет жидкость, если его сломать.\"}]}"]
	quest.0ECA16F7D304A0C1.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Электропомпа\"}]}"
	quest.0ECA16F7D304A0C1.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Качает жидкость из мира (вода, лава) в бак/трубу. Ставь над озером — помпа выкачивает источники вниз и в стороны.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лавовое озеро + помпа + геотермальный генератор = бесконечная энергия на старте.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выкачанные источники исчезают — лавовое озеро со временем кончится (вода из «бесконечного» озера — нет).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Фильтр (улучшение) — выкачивать только нужную жидкость.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ест немного FE.\"}]}"]
	chapter.3C4393CE5D2DD2D8.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Mekanism\"}]}"
	quest.2C61A0E5BE08B2CD.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Что такое Mekanism\"}]}"
	quest.2C61A0E5BE08B2CD.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Mekanism — главный мод «химии» и переработки: обогащение руд ×\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"…×\"}, {\"text\": \"5,\", \"color\": \"#E0C8FF\"}, {\"text\": \" газы, сплавы, реакторы, телепорты.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машины работают на FE (в окне — джоули). Каждая сторона машины настраивается: что входит, что выходит. Это делает конфигуратор или вкладка «Настройка сторон» в окне машины.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшения (скорость, энергия, фильтр) ставятся в правую колонку окна.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: универсальный кабель, механическая труба (жидкость), напорная трубка (газ), логистический транспортёр (предметы).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Важно: машины Mekanism не взрываются от «перенапряжения», в отличие от IU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Модули улучшений: скорость (×до \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \"), энергия, фильтр, гашение (muffling).\"}]}"]
	quest.6F3DBF9DF06F7DCE.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Стальной корпус\"}]}"
	quest.6F3DBF9DF06F7DCE.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Основа всех машин Mekanism: сталь + осмий + стекло.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сталь бери из доменной печи IE, позже — из металлургического заполнителя.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Стальной корпус = \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" стали + \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" стекла + осмий (центр).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сделай сразу \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \": обогатитель, заполнитель, дробитель, сепаратор, камеры.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Корпус не ставится как машина — это деталь.\"}]}"]
	quest.07D97DCA4974CBD2.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Обогатитель\"}]}"
	quest.07D97DCA4974CBD2.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Руда → \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" пыли (×\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"). Ещё: самоцвет → кристалл (флюорит!), уголь → сжатый уголь для заполнителя.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Это первая ступень переработки руд Mekanism. Дальше: очистка (×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"), инжекция (×\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"), растворение (×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \").\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Обогатитель также делает сжатый уголь/редстоун/алмаз/обсидиан для заполнителя.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшения скорости сильно ускоряют.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже — обогатительная фабрика (до \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" предметов сразу).\"}]}"]
	quest.77DEB3A227C9576E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Металлургический заполнитель\"}]}"
	quest.77DEB3A227C9576E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пропитывает металл веществом: железо + уголь → обогащённое железо → сталь; осмий + редстоун → infused alloy (пропитанный сплав).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Вещество (уголь, редстоун, алмаз, обсидиан) сначала заливается в левый «бак» машины, потом расходуется.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пропитанный, армированный и атомный сплавы — тиры деталей Mekanism.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Если заполнитель «стоит», проверь, что в левом баке нужное вещество, а не другое — его можно сбросить кнопкой.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сталь Mekanism быстрее, чем из доменной печи IE.\"}]}"]
	quest.5FE1E513B45774A6.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Конфигуратор\"}]}"
	quest.5FE1E513B45774A6.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Инструмент Mekanism. Shift+ПКМ в воздухе — смена режима: настройка предметов, жидкостей, газов, энергии, выгрузка, поворот.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В режиме настройки ПКМ по стороне машины переключает её цвет: синий — вход, красный/оранжевый — выход, серый — выкл.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Режим «Выгрузка» вытаскивает из машины содержимое (не потеряешь жидкость при перестройке).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Конфигуратор также разворачивает машины и снимает их (как ключ).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Цвета сторон: синий — вход, красный/оранжевый — выход, зелёный/жёлтый — доп. входы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжай его — он работает от энергии.\"}]}"]
	quest.1336C22DA199E9F8.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Пропитанный сплав\"}]}"
	quest.1336C22DA199E9F8.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Гейт ступени S\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \": из него улучшения, продвинутые схемы, солнечные генераторы Mekanism, базовые панели Powah.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Армированный сплав: пропитанный + алмаз; атомный: армированный + очищенный обсидиан.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сплавы тиров — детали продвинутых улучшений и схем Mekanism.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже армированный сплав нужен нано-дрели IU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: поставь заполнитель на автомат (осмий + редстоун из сундука) — сплава нужно десятки.\"}]}"]
	quest.41969CB8872911F6.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Камера очистки\"}]}"
	quest.41969CB8872911F6.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Руда + кислород → \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" сгустка (×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"). Кислород — из воды в электролитическом сепараторе.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сгустки → обогатитель → пыль → печь. Так руда даёт \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" слитка.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшение скорости + кислород из сепаратора = быстрая линия ×\"}, {\"text\": \"3.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сгустки нельзя плавить — только в обогатитель (сначала в «грязную пыль»).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дальше: инжекция ×\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" и растворение ×\"}, {\"text\": \"5.\", \"color\": \"#E0C8FF\"}]}"]
	quest.36513184AB517A7F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Электролитический сепаратор\"}]}"
	quest.36513184AB517A7F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Вода → водород + кислород. Солёная вода → натрий + хлор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Газы выходят с разных сторон (цвета в настройке сторон). Ненужный газ можно сбрасывать в воздух кнопкой «сброс».\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Водород — топливо газового генератора, кислород — камере очистки.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сепаратору нужно много энергии — ставь рядом хороший генератор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Водород заправляет джетпак и броню Mekanism.\"}]}"]
	quest.49A5DA3AB5618F48.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Камера инжекции\"}]}"
	quest.49A5DA3AB5618F48.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Руда + хлороводород → \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" осколка (×\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"). Хлороводород: хлор + водород в химическом инфузоре.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Цепочка ×\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \": инжекция → очистка → обогатитель → печь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Хлор: из солёной воды (вода + соль в выпаривающем заводе или солевой блок) в сепараторе.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Химический инфузор: хлор + водород → хлороводород.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Цепочка ×\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" стоит того: каждая руда даёт \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" слитка.\"}]}"]
	quest.0F18C2E4CF31C9DA.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Квантовый запутыватель\"}]}"
	quest.0F18C2E4CF31C9DA.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Телепорт ресурсов между любыми местами и ИЗМЕРЕНИЯМИ: предметы, жидкости, газы, энергия, тепло — всё одновременно.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Как: поставь два запутывателя, в окне каждого выбери ОДНУ и ту же частоту (создай свою). Что входит в один — выходит из другого.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пример: в Незере помпа качает лаву из лавового моря → запутыватель; дома запутыватель → геотермальные генераторы. Бесконечная лава без труб.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Стороны настраиваются как у машин: на входе — синие, на выходе — оранжевые. Чанк с ним должен быть прогружен (см. квест про FTB Chunks).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Частоты бывают личными и общими — для друга сделай общую.\"}]}"]
	quest.6E8B8205FC799199.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Реактор деления\"}]}"
	quest.6E8B8205FC799199.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ступень «Поздний». Мультиблок из корпусов, стекла, портов и топливных сборок. Топливо делится, нагревает охладитель (воду/натрий) → пар.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пар идёт в индустриальную турбину — она и даёт энергию. Сам реактор энергию не выдаёт!\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"ОПАСНО: при перегреве реактор взрывается и заражает местность. Ставь логический адаптер на аварийное отключение и следи за температурой.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Охладитель: вода (пар) или натрий (жидкий натрий → нагретый натрий → теплообменник).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ядерные отходы — в нейтронный активатор (полоний) или центрифугу (плутоний).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Начинай с малой скорости горения и повышай, глядя на температуру.\"}]}"]
	quest.3B7AFC7D4A0C1109.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Антиматерия (SPS)\"}]}"
	quest.3B7AFC7D4A0C1109.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сверхкритический преобразователь фаз: полоний + огромное количество энергии → антиматерия.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Антиматерия — гейт эндгейма: генераторы нитро, реакторы, наш мод.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"SPS — мультиблок \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" (корпуса, порты, катушки сверхзаряда).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"На вход — полоний (газ), на катушки — очень много энергии.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Антиматерия выходит газом; кристаллизатор делает пеллеты.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заранее построй мощную энергетику (деление + турбина).\"}]}"]
	quest.0A36F788E4404D8C.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Термоядерный реактор\"}]}"
	quest.0A36F788E4404D8C.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Эндгейм энергетики Mekanism: миллионы FE/т. Мультиблок \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"5 с\", \"color\": \"#E0C8FF\"}, {\"text\": \" контроллером, рамками, стеклом и портами.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Топливо — дейтерий + тритий. Запуск: зажигание лазерами (зарядите лазерный усилитель) или горячей капсулой.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт контроллера — с ядром виверны Draconic и заряженным аметрином.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Реактор нужно охлаждать водой — тогда он производит ещё и пар.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Если температура упала — реактор гаснет, нужен повторный запуск.\"}]}"]
	quest.12FAD6A503987317.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Камера растворения (×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \")\"}]}"
	quest.12FAD6A503987317.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Последняя ступень переработки Mekanism: руда + серная кислота → «грязная» суспензия (slurry). В итоге из \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" руды выходит \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" слитков.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Серная кислота: сера → диоксид серы (химический окислитель) → триоксид (химический инфузор с кислородом) → + вода = кислота.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Цепочка ×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \": растворение → промывка → кристаллизация → инжекция (осколки) → очистка (сгустки) → обогатитель (грязная пыль → пыль) → печь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: выстрой цепочку один раз, соедини логистическими транспортёрами и забудь — это главная фабрика руд середины игры.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Кислоту подавай напорными трубками; машине ещё нужна энергия.\"}]}"]
	quest.3BA7457A18E2A9A9.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Промывка и кристаллизация\"}]}"
	quest.3BA7457A18E2A9A9.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Химическая промывочная машина: грязная суспензия + вода → чистая суспензия. Воду подавай трубой (электропомпа рядом — идеально).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Химический кристаллизатор: чистая суспензия → кристаллы металла.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Если промывочная «стоит» — проверь, что ей хватает воды (мБ/т заметно) и есть куда отдавать чистую суспензию.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь промывку и кристаллизатор вплотную и настрой стороны конфигуратором.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшения скорости в этой цепочке лучше ставить сразу во все машины одинаково.\"}]}"]
	quest.5593067ED1E07651.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \": кристаллы металла\"}]}"
	quest.5593067ED1E07651.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Кристаллы — продукт кристаллизатора. Дальше: камера инжекции → осколки → очистка → сгустки → обогатитель → печь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Работает для железа, золота, меди, олова, осмия, свинца, урана и др.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Кристаллы можно хранить, если цепочка дальше ещё не готова.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Кристаллы не плавятся напрямую — только через инжекцию.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выход ×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" — максимум переработки в сборке.\"}]}"]
	quest.68156BF4CAA34782.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Камера реакций под давлением\"}]}"
	quest.68156BF4CAA34782.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Три входа: предмет + жидкость + газ → предмет + газ. Пример: опилки/биотопливо + вода + водород → этилен; этилен-субстрат → пластик HDPE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"HDPE-листы нужны для QIO, модулей MekaSuit и ряда наших рецептов. Этилен — лучшее топливо газового генератора.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Также делает плазмореактивы Maelstrom Tech.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Камере нужно много энергии и давление — смотри шкалы в окне.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепты PRC — отдельная категория JEI.\"}]}"]
	quest.6FBDB8620B1CEC8B.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Солнечный нейтронный активатор\"}]}"
	quest.6FBDB8620B1CEC8B.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ядерные отходы реактора деления → полоний. Работает от солнца (нужно небо), энергии не просит.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Изотопная центрифуга рядом делает из отходов плутоний.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Полоний и плутоний (пеллеты) — гейт поздней энергетики (S\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \") и топливо SPS.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ночью и в дождь не работает — ставь несколько.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Изотопной центрифуге нужна энергия.\"}]}"]
	quest.6D48D98AF230BE61.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Полоний и плутоний\"}]}"
	quest.6D48D98AF230BE61.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пеллеты делает химический кристаллизатор из газа полония/плутония.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Плутоний — гейт ступени S\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" (поздние генераторы Powah, газовый генератор, DE-генератор). Полоний — топливо SPS для антиматерии.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Газы полония/плутония радиоактивны: не ломай трубы и баки с ними — заражение местности.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Чистится радиация радиационным фильтром/временем.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Носи костюм радиационной защиты Mekanism у реактора.\"}]}"]
	quest.4B924FEB14B09738.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Индукционная матрица\"}]}"
	quest.4B924FEB14B09738.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Огромное хранилище энергии Mekanism. Мультиблок-коробка (от \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" до \"}, {\"text\": \"18\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"18\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"18\", \"color\": \"#E0C8FF\"}, {\"text\": \") из индукционных корпусов и стекла, с портами.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Внутри: индукционные ячейки (ёмкость) и провайдеры (скорость ввода/вывода). Ячейки и провайдеры бывают \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" тиров.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Порт: ПКМ конфигуратором переключает режим вход/выход.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Это «аккумулятор базы» до энергоядра Draconic.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: начни с \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" и базовых ячеек — расширяй со временем.\"}]}"]
	chapter.042FDF2B96B84801.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Кристаллы: Industrial Foregoing и Powah\"}]}"
	quest.1905873677A13B42.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Industrial Foregoing и Powah\"}]}"
	quest.1905873677A13B42.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Industrial Foregoing (IF) — фермы и автоматизация: лазерный бур добывает руды и кристаллы без копания, мобо-фермы, жидкостные машины.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Powah — генераторы и энергизирующий орб, который «заряжает» предметы энергией.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Вместе они дают кристаллы тиров: хризолит и аметрин (бур), заряженные версии (орб).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машины IF работают на FE; многие имеют рабочую зону (подсветка кнопкой в окне).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рамки IF: жалкая → простая → продвинутая → высшая; каждая открывает машины нового тира.\"}]}"]
	quest.48864BF540F42B8F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Жалкая рамка\"}]}"
	quest.48864BF540F42B8F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Основа машин IF первого тира. Дальше: простая → продвинутая → высшая рамки.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт рамки в нашей сборке изменён — смотри JEI (R на рамке).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"С неё делаются первые машины IF: жалкий генератор, рудный бур.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Простая рамка — следующий тир, с пластиком IF.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пластик IF — из латекса (жидкостный экстрактор у каучукового дерева) и сушки.\"}]}"]
	quest.22142C2ACB6115D9.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Лазерный бур\"}]}"
	quest.22142C2ACB6115D9.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Основа рудного бура + лазерные буры вокруг (по сторонам). Буры светят в основу, основа «выкапывает» руды из пустоты.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Линза в основе выбирает цвет — и что добывается. Без линзы — случайные руды.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Буры едят много FE — подключи хорошую энергию (ступень «Ранний» и выше).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Чем больше лазерных буров вокруг основы (до \"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \"), тем быстрее добыча.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Добыча идёт «по воздуху» — сам мир не трогается.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Цвета линз: каждая линза повышает шанс своей группы руд.\"}]}"]
	quest.26FBAB1F2E6D29C0.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Хризолит\"}]}"
	quest.26FBAB1F2E6D29C0.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Зелёная линза в лазерном буре → хризолит. Второй кристалл-тир.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Открывает ступень «Средний»: ветряк, продвинутая солнечная Mekanism, Powah hardened, генераторы Oritech/IF на жидком топливе, Flux Networks.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Хризолит добывается только буром — на автомат его ставь сразу.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пыль хризолита — дробилка IE или Mekanism.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Следующий кристалл — аметрин (фиолетовая линза).\"}]}"]
	quest.34A533961C21B56E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Аметрин\"}]}"
	quest.34A533961C21B56E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Фиолетовая линза → аметрин (реже хризолита). Третий кристалл-тир — для поздней энергетики, Draconic и наших машин.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Чистый аметрин нужен стабилизаторам и пилонам энергоядра Draconic.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряженный аметрин — один из самых частых ингредиентов эндгейма, держи бур на фиолетовой линзе постоянно.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Аметрин реже хризолита — поставь больше буров.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пыль аметрина — дробилка IE или Mekanism.\"}]}"]
	quest.27B888B6AE8EFBCE.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Энергизирующий орб\"}]}"
	quest.27B888B6AE8EFBCE.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Орб + энергизирующие стержни вокруг (до \"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" блоков). Энергию подавай на СТЕРЖНИ, не на орб.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Положи предмет в орб (ПКМ) — он заряжается и превращается: кристалл → заряженный кристалл, железо+золото → заряженная сталь Powah.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Чем лучше стержни, тем быстрее.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Стержни: базовые → закалённые → … → нитро; их скорость складывается.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергию на стержни — кабелем Powah/Mekanism/Flux к любому стержню.\"}]}"]
	quest.71627472CC1558DE.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Заряженный флюорит\"}]}"
	quest.71627472CC1558DE.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Флюорит в орбе. Нужен продвинутым энергокубам, платам тир \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" и ряду машин.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия: \"}, {\"text\": \"500 тыс.\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE на кристалл.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Чем лучше стержни, тем быстрее.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряженный флюорит — гейт ступени «продвинутые» (энергокубы, панели IU).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь орб на автомат: шина AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" подаёт кристаллы, выталкивает готовые.\"}]}"]
	quest.446376A883F261E5.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Заряженный хризолит\"}]}"
	quest.446376A883F261E5.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Хризолит в орбе — следующий тир деталей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия: \"}, {\"text\": \"2 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE на кристалл.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужен плате т\"}, {\"text\": \"3,\", \"color\": \"#E0C8FF\"}, {\"text\": \" нано-дрели IU, части генераторов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: держи орб отдельно под каждый кристалл.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже — заряженный аметрин.\"}]}"]
	quest.2D34AA8C81E3003B.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Заряженный аметрин\"}]}"
	quest.2D34AA8C81E3003B.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Аметрин в орбе — самый дорогой кристалл. Нужен реактору деления, термояду, ультимативным кубам, квантовому сплаву.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия: \"}, {\"text\": \"8 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE на кристалл — нужен хороший генератор (ступень «Средний» и выше).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Самые частые потребители: реактор деления, термояд, панели LoliLand, квантовый сплав.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь орб с лучшими стержнями.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: держи \"}, {\"text\": \"16\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"32\", \"color\": \"#E0C8FF\"}, {\"text\": \" штуки в запасе перед эндгейм-стройками.\"}]}"]
	quest.3A8FC016EAAD0925.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Плата тир \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}]}"
	quest.3A8FC016EAAD0925.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Наша плата — связующее звено модов: пыль флюорита + плата IE (верстак инженера по чертежу) + базовая схема Mekanism.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Платы тиров \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"→\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" идут в машины и снаряжение разных модов — так моды переплетены.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Плата IE делается на верстаке инженера IE по чертежу (чертёж — верстак + бумага).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Т\"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" → т\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" → т\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" → т\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"; каждая следующая требует деталей из других модов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Платы — первые кандидаты на автокрафт AE\"}, {\"text\": \"2.\", \"color\": \"#E0C8FF\"}]}"]
	quest.7F4B3DF9C608E900.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Плата тир \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}]}"
	quest.7F4B3DF9C608E900.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Плата т\"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" + заряженный флюорит + энергетический сплав Ender IO + часть схемы IU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергетический сплав Ender IO — сплавочная печь EIO.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Плата т\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" = т\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" + заряженный хризолит + логический процессор AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" + элитная схема Mekanism.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Плата т\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" — эндгейм (с ядром виверны).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Т\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" открывает продвинутые машины и квантовые инструменты.\"}]}"]
	quest.1E354D1E68CFDD49.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Квантовый сплав\"}]}"
	quest.1E354D1E68CFDD49.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дуговая печь IE (большой мультиблок, электроды из графита): иридий + очищенный обсидиан + заряженный аметрин.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ключевой материал позднего тира: квантовая броня, финальные машины.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дуговая печь IE — мультиблок: строй по справочнику IE, электроды из графита.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Иридий — из UU-материи (генератор материи IU).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Очищенный обсидиан — заполнитель Mekanism (обсидиан → пыль → + алмаз).\"}]}"]
	chapter.3ACB3BC6FBAA88E0.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Ender IO и броня\"}]}"
	quest.456E1A57F18E9C71.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Что такое Ender IO\"}]}"
	quest.456E1A57F18E9C71.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ender IO — сплавы (энергетический, вибрирующий, тёмная сталь), трубы-«проводники» всё-в-одном, фермерская станция, SAG-мельница.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Проводник EIO в одном блоке несёт энергию, предметы, жидкости и редстоун.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Конденсаторы EIO (базовый, двойной, октадический) — улучшают машины EIO: вставь в слот конденсатора.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машины EIO можно красить «маскировкой» под любой блок.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия EIO — FE.\"}]}"]
	quest.6598FE85D14E6807.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"SAG-мельница\"}]}"
	quest.6598FE85D14E6807.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дробит руду в пыль с шансом бонуса. Шары для помола (вставляются в слот) повышают выход.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Шары тёмной стали/энергетические — у нас со сплавом IU или Mekanism.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Работает на FE, вставь конденсатор для скорости.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Без шаров тоже работает, но без бонуса.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Альтернатива дробителю IU и обогатителю Mekanism.\"}]}"]
	quest.5F9BD0BA57AC3489.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Сплавы Ender IO\"}]}"
	quest.5F9BD0BA57AC3489.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сплавочная печь EIO: золото + редстоун + светопыль → энергетический сплав. Дальше — вибрирующий (+ жемчуг Края), тёмная сталь (+ обсидиан).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сплавы идут в банки конденсаторов, проводники, платы тир \"}, {\"text\": \"2.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сплавочная печь EIO делает и обычные сплавы (бронзу, электрум) и плавит как печь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Вибрирующий сплав — для продвинутых конденсаторов и проводников.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Тёмная сталь — броня и инструменты EIO.\"}]}"]
	quest.772C4F4DC0AFBD66.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Дрель IU\"}]}"
	quest.772C4F4DC0AFBD66.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Электрический инструмент: копает камень и руду быстрее кирки, ест EU вместо прочности.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжай в хранилище IU или носи батпак. Рецепт с флюоритом.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Алмазная дрель — следующий шаг (дрель + алмазы).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Режим «тихое касание» и область — у старших дрелей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Электроинструменты не ломаются — только разряжаются.\"}]}"]
	quest.4AD119DF453A6A8E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Нано-броня\"}]}"
	quest.4AD119DF453A6A8E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Углепластик + энергокристаллы. Броня поглощает урон за счёт энергии; шлем даёт ночное зрение.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжай в хранилище. Дальше — квантовая броня (полёт, защита от всего).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нано-броня работает, пока есть заряд; без заряда защищает слабо.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Шлем делается с очками ночного видения.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Полный комплект заметно снижает урон от падения и мобов.\"}]}"]
	quest.7ADA886F39D36BBD.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Квантовая броня\"}]}"
	quest.7ADA886F39D36BBD.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Вершина брони IU: полёт, бег, высокий прыжок, защита. Требует много энергии и промышленного иридия.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Квантовый шлем: дыхание под водой, сытость, ночное зрение.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нагрудник: полёт (как джетпак) и защита.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Поножи — бег, ботинки — прыжок и защита от падения.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжай в MFSU — ёмкость большая.\"}]}"]
	chapter.1227B553231C9DBF.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Forestry: пчёлы\"}]}"
	quest.66664B1762967FFB.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Что такое Forestry\"}]}"
	quest.66664B1762967FFB.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Forestry — мод про пчёл, деревья и фермы. В нашей сборке он нужен ради продуктов пчёл: сот, воска, прополиса, маточного молочка и пыльцы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Эти продукты идут в рецепты пчеловодческих солнечных панелей Maelstrom Tech и в некоторые детали.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пчёлы — живые: у них есть гены (вид, скорость, продуктивность, климат). Скрещивая виды, получаешь новые.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пчеле нужен подходящий климат (температура и влажность биома), дневной свет и цветы рядом. Если пчела «не работает» — наведи анализатор, он покажет причину.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Начни с пасеки рядом с базой: пчёлы работают сами, пока чанк загружен.\"}]}"]
	quest.6CC372199AA9DE93.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Сачок и первые пчёлы\"}]}"
	quest.6CC372199AA9DE93.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сачок делается на верстаке. Найди в мире улей (блок с пчёлами на дереве или в земле) и разбей его сачком.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выпадут принцесса и трутни — это пара для разведения. Принцесса + трутень в пчелином домике/пасеке → королева, она живёт и производит соты.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ульи разных биомов дают разные виды: лесные, луговые, болотные (Mossy), пустынные, снежные, тропические, адские.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Собери пчёл из нескольких биомов — понадобятся для скрещивания.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: возьми несколько принцесс — одна может погибнуть при неудачном климате.\"}]}"]
	quest.5A88633FBBD56486.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Пасека\"}]}"
	quest.5A88633FBBD56486.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пасека — лучше пчелиного домика: в неё ставятся рамки (до \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"), которые ускоряют работу и повышают выход.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Как: положи принцессу и трутня в верхние слоты. Продукты (соты) падают в правые слоты — забирай трубой/воронкой.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рамки изнашиваются. Необработанные (untreated) — дешёвые, пропитанные и проверенные (proven) — дольше и лучше.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ошибка новичка: ставить пасеку в пещере. Пчёлам нужно небо над головой (или улучшение «небо» в улье Alveary) и день.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пасека не требует энергии.\"}]}"]
	quest.2C2E4AE04FF9F772.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Соты\"}]}"
	quest.2C2E4AE04FF9F772.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каждый вид пчёл даёт свои соты: медовые (лес, луг), какао (джунгли), тлеющие (Незер), мшистые, морозные, сухие, шёлковые и т.д. — всего \"}, {\"text\": \"14\", \"color\": \"#E0C8FF\"}, {\"text\": \" видов в сборке.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Соты сами по себе почти не нужны — их перерабатывают в центрифуге.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Новые виды получаются скрещиванием: принцесса одного вида + трутень другого. Шанс мутации показан в JEI (категория скрещивания пчёл).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: держи по паре чистокровных пчёл каждого вида (трутни + принцесса) — «библиотека» для скрещиваний.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Анализатор (портативный) показывает, чистокровная ли пчела, и её признаки; ему нужна медовая капля.\"}]}"]
	quest.115E12A5653E0F6C.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Центрифуга Forestry\"}]}"
	quest.115E12A5653E0F6C.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Соты → воск, медовые капли, прополис, пыльца, шёлк — смотря какие соты. Работает на FE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь рядом с пасекой и соединяй трубой — получится автоматическая пасека.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сжиматель (squeezer) рядом выжимает из капель мёд, из семян — масло.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выход центрифуги — с шансом: смотри проценты в JEI.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь улучшения/ускорение не нужно — просто поставь \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" центрифуги.\"}]}"]
	quest.77BEE31963B11A29.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Плотник\"}]}"
	quest.77BEE31963B11A29.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машина-верстак с баком жидкости. Делает рамки, платы Forestry, пропитанные доски и ящики.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В бак заливается вода, мёд или креозот (из коксовой печи IE) — это часть рецепта. Работает на FE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Термионный изготовитель рядом плавит песок в стекло и делает трубки для плат.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Жидкость в бак плотника заливается ведром, капсулой или трубой.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепты плотника — отдельная категория JEI.\"}]}"]
	quest.38042A3B8A5F3C46.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Проверенные рамки\"}]}"
	quest.38042A3B8A5F3C46.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лучшие обычные рамки: заметно повышают продуктивность пасеки и живут долго.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Делаются в плотнике. Пропитанная рамка (impregnated) нужна и в рецептах пчеловодческих панелей Maelstrom Tech.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рамки ставятся в пасеку и улей Alveary (в Alveary — через рамочный блок).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Изношенные рамки исчезают — держи запас.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рамки делаются в плотнике из воска, дерева и мёда.\"}]}"]
	quest.1F969D89E0E6445F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Маточное молочко и пыльца\"}]}"
	quest.1F969D89E0E6445F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Маточное молочко дают некоторые виды пчёл (в основном тропические/лесные линии), пыльцу — центрифуга сот и пчёлы с геном «опыление».\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Молочко и пыльца — ключевые продукты для пчеловодческих панелей Maelstrom Tech (синяя, зелёная, фиолетовая, янтарная → улучшенные → ультимативная четырёхцветная).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Молочко хранится бесконечно — копи его.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пыльцу дают и центрифуги некоторых сот.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Для пчеловодческих панелей нужны десятки молочка — начни пасеку пораньше.\"}]}"]
	quest.05B6EBE0EF7ABD1D.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Улей Alveary\"}]}"
	quest.05B6EBE0EF7ABD1D.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Мультиблок-пасека «совершенного уровня». Основание \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" и высота \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" блока из блоков улья; один из боковых блоков — с отверстием для доступа.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Добавочные блоки вместо обычных: роитель (раздаёт принцесс), вентилятор (охлаждает), обогреватель (греет), стабилизатор (защищает от мутаций).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Так любой вид можно держать в любом биоме: климат подгоняется вентилятором и обогревателем.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия нужна только активным блокам (вентилятор, обогреватель).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Без «неба» Alveary работает только с соответствующим улучшением — ставь его под открытым небом.\"}]}"]
	quest.0050D5187F5849F1.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Совершенная пасека\"}]}"
	quest.0050D5187F5849F1.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пасека-фабрика LoliLand: матка Forestry работает от энергии, без цветов, рамок и подбора климата.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Положи матку (или принцессу и трутня — пасека сама их спарит). Цикл \"}, {\"text\": \"550\", \"color\": \"#E0C8FF\"}, {\"text\": \" тиков (\"}, {\"text\": \"27,5 с\", \"color\": \"#E0C8FF\"}, {\"text\": \"), \"}, {\"text\": \"160 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" — \"}, {\"text\": \"88\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000 FE\", \"color\": \"#E0C8FF\"}, {\"text\": \" за цикл.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Продукты — как у вида пчелы: шанс × скорость гена. Каждые \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" сот дают сотовую пластину — её делает только эта пасека.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сотовые пластины нужны пчеловодческим солнечным панелям (боковая лестница LoliLand) и улучшениям пасеки.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Матка стареет: после смерти пасека выдаёт принцессу её вида и трутней по плодовитости (без мутаций).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выход — \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" слотов; забирай трубой или поставь улучшение «Автовывод».\"}]}"]
	quest.7BA0BE96F5D5F025.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Улучшения пасеки\"}]}"
	quest.7BA0BE96F5D5F025.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" слота улучшений. Скорость I/II/III — цикл ×\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"/×\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"/×\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" быстрее (вместе до ×\"}, {\"text\": \"64\", \"color\": \"#E0C8FF\"}, {\"text\": \"), энергия растёт так же.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Удача — шанс продуктов ×\"}, {\"text\": \"5,\", \"color\": \"#E0C8FF\"}, {\"text\": \" энергия ×\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" (нужен слиток бесконечности).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Бесконечность — матка не стареет и не умирает.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Климат — пчёлы дают и специальности (как в идеальных условиях), энергия ×\"}, {\"text\": \"1,5.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Автовывод — раз в секунду выталкивает продукты в соседние сундуки и трубы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Две «Скорости III» = ×\"}, {\"text\": \"64\", \"color\": \"#E0C8FF\"}, {\"text\": \": цикл меньше секунды при ≈\"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" (×\"}, {\"text\": \"2 с\", \"color\": \"#E0C8FF\"}, {\"text\": \" удачей).\"}]}"]
	chapter.2AB957C6D02F7422.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Oritech\"}]}"
	quest.4741541B4EDC6298.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Что такое Oritech\"}]}"
	quest.4741541B4EDC6298.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Oritech — красивый техно-мод: машины-аддоны, лазеры, ускоритель частиц, атомная кузня, реактор на стержнях.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машины Oritech занимают несколько блоков, их можно улучшать «аддонами» — блоками, приставленными вплотную (скорость, эффективность, вывод).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"В сборке Oritech нужен ради флюксита, сверхпроводника, ускорителя частиц и кристаллов перезарядки — они входят в кварковый реактив и поздние детали.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия Oritech — FE; многие машины требуют «рамку» и аддоны рядом.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Справочник Oritech (книга) описывает каждую машину.\"}]}"]
	quest.5AD19CB91CDB12BB.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Мотор и рама\"}]}"
	quest.5AD19CB91CDB12BB.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Мотор — базовая деталь Oritech. Рама машины (machine frame) — каркас для лазерной руки, карьера и ускорителя.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рамы ставятся блоками рядом с машиной и задают её рабочую зону.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Мотор — в сборщике или на верстаке (смотри JEI).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рама ставится рядом с машиной в ряд — её размер = рабочая зона.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Моторов уйдёт много — сделай \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"16.\", \"color\": \"#E0C8FF\"}]}"]
	quest.0923C5525129E75A.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Пульверизатор и плавильня\"}]}"
	quest.0923C5525129E75A.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пульверизатор: руда → \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" пыли. Плавильня (foundry): сплавы — электрум, сталь, адамант, биосталь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Работают на FE. Аддон-ускоритель рядом повышает скорость, аддон-эффективность снижает расход.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пульверизатор занимает несколько блоков — смотри призрак при установке.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Плавильня даёт биосталь — нужна био-генератору Oritech.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Выход — в сундук рядом или трубой.\"}]}"]
	quest.594681FF0B6DBB7E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Сборщик\"}]}"
	quest.594681FF0B6DBB7E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машина-сборщик Oritech: \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" входа → деталь. Делает процессоры, сверхпроводник, флюкс-шлюзы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сборщик принимает предметы с любой стороны.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь аддоны скорости — сборщик медленный.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепты сборщика — отдельная категория JEI.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия — FE.\"}]}"]
	quest.7C9EAFE2A0A72A9D.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Флюксит\"}]}"
	quest.7C9EAFE2A0A72A9D.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Осколок аметиста в энергизирующем орбе Powah или заряднике AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" → флюксит. Позже — столкновение частиц в ускорителе.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужен для сверхпроводника и большой солнечной панели Oritech.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Флюксит в орбе — \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" осколок → \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" флюксит.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже ускоритель даёт его быстрее.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Держи запас: \"}, {\"text\": \"16\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"32.\", \"color\": \"#E0C8FF\"}]}"]
	quest.05EA7379AAB2A092.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Кольцо ускорителя\"}]}"
	quest.05EA7379AAB2A092.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ускоритель частиц — длинное кольцо (или петля) из колец-направляющих, моторов ускорителя и сенсоров.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Частицы разгоняются по кольцу; чем длиннее прямые участки и больше моторов, тем выше скорость.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Строй в прогруженном чанке — частица теряется, если чанк выгрузился.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Направляющие колец ставь подряд, повороты — особыми блоками.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сенсор показывает скорость частицы.\"}]}"]
	quest.559778D392E190BA.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Ускоритель частиц\"}]}"
	quest.559778D392E190BA.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Контроллер принимает два предмета, разгоняет и сталкивает их. Результат зависит от скорости столкновения (рецепты в JEI).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Так получают экзотические материалы, в т.ч. флюксит и детали атомной кузни.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт контроллера — с ядром виверны (ступень S\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \").\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Предметы подаются в контроллер, результат — в его выход.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Высокие скорости требуют длинного кольца и многих моторов.\"}]}"]
	quest.1C831FDA1FA46B9F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Атомная кузня\"}]}"
	quest.1C831FDA1FA46B9F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Многоблочная кузня: ядро + пьедесталы. Энергию даёт лазер Oritech, направленный на кузню.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Делает кристаллы перезарядки и другие эндгейм-детали Oritech.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лазер Oritech ставится на расстоянии и светит в кузню; ему нужна энергия.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"На пьедесталы кладутся ингредиенты, в ядро — основной предмет.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепты кузни — отдельная категория JEI.\"}]}"]
	quest.498406F7700741F7.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Кристалл перезарядки\"}]}"
	quest.498406F7700741F7.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Продукт атомной кузни. \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" кристалла + экзотермический реактив в слиянии Draconic → кварковый реактив (ветка Maelstrom Tech).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Кристаллы перезарядки нужны и для мощных деталей Oritech.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Держи \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" штук под кварковый реактив.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Копи под плазмореактивы Maelstrom.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт — атомная кузня.\"}]}"]
	chapter.3F15A8461E00D97A.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Applied Energistics \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}]}"
	quest.5089AE13C7456206.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Что такое Applied Energistics \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}]}"
	quest.5089AE13C7456206.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" — цифровое хранилище: тысячи предметов в одном терминале, поиск по названию, автокрафт.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сеть = контроллер + кабели + устройства. Обычный кабель передаёт \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" «каналов» (устройств), плотный — \"}, {\"text\": \"32.\", \"color\": \"#E0C8FF\"}, {\"text\": \" Контроллер раздаёт каналы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сеть ест немного энергии FE — подключи к любой энергосети через энергоакцептор или прямо к контроллеру.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каналы: каждое устройство (шина, терминал, интерфейс) занимает \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" канал. Если не работает — проверь каналы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Плотный кабель — \"}, {\"text\": \"32\", \"color\": \"#E0C8FF\"}, {\"text\": \" канала; P\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"P-туннели передают каналы далеко.\"}]}"]
	quest.632D236E5D9295E0.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Кварц истинности\"}]}"
	quest.632D236E5D9295E0.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ищи метеориты (кратер с небесным камнем) — внутри почкующийся кварц и пресс-формы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Кварц растёт сам на почкующемся блоке. Ускоритель роста ускоряет.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Для автоматической фермы: почкующийся кварц + ускоритель роста + разрушитель (formation/annihilation plane).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Почкующийся блок деградирует при сборе — ставь безупречный (flawless) из метеорита.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Кварц Незера тоже понадобится — для флюикса и процессоров.\"}]}"]
	quest.7C9042D1316AE614.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Зарядник\"}]}"
	quest.7C9042D1316AE614.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжает кварц истинности энергией FE. Заряженный кварц нужен для флюикса.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Зарядник также заряжает инструменты AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" (энергетические).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ест немного FE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Автоматизация: воронка сверху, выход снизу.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже — расширенный зарядник ExtendedAE на несколько предметов.\"}]}"]
	quest.0079D3A48E293442.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Флюикс\"}]}"
	quest.0079D3A48E293442.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряженный кварц + редстоун + кварц Незера: брось в воду — получится флюикс.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Флюикс — кабели и почти все детали сети.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Можно делать автоматически: формирующая плоскость роняет ингредиенты в воду.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Флюикс-пыль — для ME-стекла и кабелей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Чистый флюикс растёт так же, как кварц.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Флюикс-кабели можно красить красителем — кабели разных цветов не соединяются.\"}]}"]
	quest.22A313A54C8CCC91.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Высекатель\"}]}"
	quest.22A313A54C8CCC91.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Печатает процессоры. В верхний и нижний слоты — пресс-формы из метеорита, в центр — материал.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Схема печати: пресс-форма + силикон/золото/алмаз/кварц → печатная плата; плата + силиконовая плата + редстоун → процессор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пресс-формы можно копировать (пресс + железный блок в высекателе).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Высекатель питается FE; улучшение скорости ускоряет.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Позже — расширенный высекатель на \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" линии.\"}]}"]
	quest.4BE5E19EE67385D6.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Процессоры\"}]}"
	quest.4BE5E19EE67385D6.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Логический (золото), вычислительный (кварц), инженерный (алмаз). Без них нет ни одного устройства AE\"}, {\"text\": \"2.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Схемы: печатная схема + печатный кремний + редстоун → процессор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Силикон — из кварцевой пыли в печи.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь их на автокрафт в первую очередь — уходят сотнями.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каждый процессор — в своей пресс-форме: логическая, вычислительная, инженерная, кремниевая.\"}]}"]
	quest.279D2950B047621F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"ME-контроллер\"}]}"
	quest.279D2950B047621F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сердце сети. В нашей сборке — по рецепту LoliLand: небесный камень + флюикс + усложнённая схема IU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Контроллеры можно ставить блоком (до \"}, {\"text\": \"7\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"7\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"7\", \"color\": \"#E0C8FF\"}, {\"text\": \") — больше каналов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Контроллер ест энергию; без питания сеть не работает.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нельзя ставить два отдельных контроллера в одну сеть — будет конфликт.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергоакцептор AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" принимает только FE; EU от IU переводи через кабель Mekanism или конвертер.\"}]}"]
	quest.05E1779F58E354B6.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"ME-накопитель и ячейки\"}]}"
	quest.05E1779F58E354B6.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Накопитель держит \"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" ячеек хранения. Ячейка \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"k хранит \"}, {\"text\": \"1024\", \"color\": \"#E0C8FF\"}, {\"text\": \" байта (до \"}, {\"text\": \"63\", \"color\": \"#E0C8FF\"}, {\"text\": \" разных предметов).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Дальше: \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"k, \"}, {\"text\": \"16\", \"color\": \"#E0C8FF\"}, {\"text\": \"k, \"}, {\"text\": \"64\", \"color\": \"#E0C8FF\"}, {\"text\": \"k, \"}, {\"text\": \"256\", \"color\": \"#E0C8FF\"}, {\"text\": \"k и MEGA-ячейки.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ячейка: «байты» — объём, «типы» — сколько разных предметов. \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"k вмещает \"}, {\"text\": \"63\", \"color\": \"#E0C8FF\"}, {\"text\": \" типа.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ячейки можно разбирать обратно (Shift+ПКМ пустой ячейкой).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Форматирование ячейки — фильтр в ячеечном верстаке.\"}]}"]
	quest.305BE408FFC088E1.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Терминал крафта\"}]}"
	quest.305BE408FFC088E1.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставится на кабель. Показывает всё содержимое сети, можно крафтить прямо из сети.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Поиск: начни печатать название. @мод — по моду.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Терминал шаблонов — для записи рецептов в шаблоны (пустой шаблон из кварца).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Беспроводной терминал работает с точки доступа.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сортировка и фильтры — кнопки слева в окне.\"}]}"]
	quest.409FF410D27F8765.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Шины\"}]}"
	quest.409FF410D27F8765.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Шина импорта забирает предметы из машины/сундука в сеть, экспорта — кладёт из сети в машину.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Так строится автоматизация: сеть кормит дробитель, забирает пыль, отправляет в печь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Шины можно улучшать картами: ускорения, ёмкости, фильтра.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Интерфейс AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" держит запас предметов в машине.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Экспортная шина с картой крафта сама заказывает недостающее.\"}]}"]
	quest.641DD4A58FC2EB65.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Автокрафт\"}]}"
	quest.641DD4A58FC2EB65.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Молекулярный сборщик + поставщик шаблонов + блок крафта (ЦП). Шаблон — «запомненный рецепт» (терминал шаблонов).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заказываешь в терминале \"}, {\"text\": \"64\", \"color\": \"#E0C8FF\"}, {\"text\": \" схемы — сеть сама делает всё дерево крафта.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Для машинных рецептов (дробитель, печь) поставщик шаблонов ставится рядом с машиной.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Блоки крафта (CPU) — хранилище + ко-процессоры; больше блоков = больше параллельных заказов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ошибка новичка: шаблон записан с неправильным количеством — проверяй выход.\"}]}"]
	quest.75702C5B654FE44D.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Химические ячейки\"}]}"
	quest.75702C5B654FE44D.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Applied Mekanistics: ячейки AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" для газов/химикатов Mekanism. Корпус + компонент хранения → ячейка \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"k…\"}, {\"text\": \"256\", \"color\": \"#E0C8FF\"}, {\"text\": \"k.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставятся в обычный ME-накопитель. Шины импорта/экспорта и интерфейсы AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" начинают понимать химикаты.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Удобно для автоматизации переработки ×\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"/×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" (кислород, водород, хлороводород, кислоты).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ячейки делаются в ячеечном верстаке AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" или на обычном верстаке (смотри JEI).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Химический терминал AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" показывает газы в сети.\"}]}"]
	quest.4BC6DC6AEF8C3AA3.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Химическая ячейка \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \"k\"}]}"
	quest.4BC6DC6AEF8C3AA3.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Типы химикатов в одной ячейке ограничены — раздели по ячейкам (газы отдельно, суспензии отдельно).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ячейки \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"k–\"}, {\"text\": \"256\", \"color\": \"#E0C8FF\"}, {\"text\": \"k: больше — больше объём.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь в обычный ME-накопитель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Переносная химическая ячейка — для заправки в походе.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Шины импорта/экспорта понимают газы автоматически.\"}]}"]
	quest.71769A27FB7762EA.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"ExtendedAE: рама\"}]}"
	quest.71769A27FB7762EA.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"ExtendedAE — расширение AE\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \": расширенные сборщики, высекатели, интерфейсы и матрица сборки.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рама машины — основа его устройств.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рамка делается из кварца, флюикса и стали (JEI).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Все устройства ExtendedAE используют ту же сеть AE\"}, {\"text\": \"2.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия — через контроллер.\"}]}"]
	quest.5568E87D5114AD1F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Энтро\"}]}"
	quest.5568E87D5114AD1F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энтро-кристаллы растут из почкующегося энтро-блока (как кварц истинности). Энтро-слиток — деталь устройств ExtendedAE.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энтро-блок ставь с ускорителем роста.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энтро-слиток — плавка/смешивание (JEI).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужен для расширенных устройств.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Держи запас \"}, {\"text\": \"16\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"32.\", \"color\": \"#E0C8FF\"}]}"]
	quest.3C995085B571B526.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Расширенный сборщик\"}]}"
	quest.3C995085B571B526.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Несколько рецептов параллельно в одном блоке. Ставь вместо обычных сборщиков рядом с поставщиком шаблонов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Занимает \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" канал.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь вплотную к расширенному поставщику шаблонов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ускоряется картами ускорения.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Можно ставить несколько рядом.\"}]}"]
	quest.62F698AC9676F50A.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Расширенные высекатель и зарядник\"}]}"
	quest.62F698AC9676F50A.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Высекатель на \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" линии и зарядник на несколько предметов — процессоры и заряженный кварц быстрее.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Занимает \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" канал.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Пресс-формы кладутся в каждую линию.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ускоряется картами ускорения.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Расширенный зарядник заряжает до \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" предметов.\"}]}"]
	quest.03CCD0EFEFCF4FB6.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Матрица сборки\"}]}"
	quest.03CCD0EFEFCF4FB6.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Мультиблок-автокрафт: рама + стены + стекло + блоки шаблонов, сборщиков и ускорителей. Огромное число параллельных крафтов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Строй коробкой: снаружи рама/стены/стекло, внутри — функциональные блоки. Подключается к сети кабелем.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Строй минимум \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Блоки шаблонов хранят много шаблонов сразу.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ускорители повышают скорость всей матрицы.\"}]}"]
	chapter.1E232FAE02082457.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Maelstrom Tech\"}]}"
	quest.2C23EF2AAD8E59D6.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Что такое Maelstrom Tech\"}]}"
	quest.2C23EF2AAD8E59D6.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Maelstrom Tech — мод этой сборки. Он соединяет эндгейм всех модов: энергоновая линия, огромные мультиблоки, солнечные панели после квантовой, машины ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \"/×\"}, {\"text\": \"12\", \"color\": \"#E0C8FF\"}, {\"text\": \" и финал — квантовый генератор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Все мультиблоки мода: Shift+ПКМ по контроллеру показывает «призрак» — полупрозрачную схему, куда ставить блоки. Собранный мультиблок рисуется цельной моделью.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия — только FE и много: норма эндгейма \"}, {\"text\": \"1 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE/т на машину, ключевая операция \"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"20\", \"color\": \"#E0C8FF\"}, {\"text\": \" минут.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машины мода питаются только FE. Скорость — по приёму FE/т; улучшение скорости Maelstrom поднимает приём.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Окна машин показывают энергию, прогресс и баки.\"}]}"]
	quest.15A4B3D8DBCE2F2F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Нейтронная звезда\"}]}"
	quest.15A4B3D8DBCE2F2F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Наш мод. Нейтронная звезда — «батарейка» для энергоновой линии. Её заряжают в плазменном заряднике.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: нейтроний + квантовый сплав + антиматерия Mekanism + деталь IU (смотри JEI).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Одна звезда = \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" зарядов после зарядника.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряженную звезду не потеряй: это катализатор, а не расходник за раз.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Звёзд нужно \"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" на всю энергоновую линию.\"}]}"]
	quest.0351030223C9CAE8.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Плазменный зарядник\"}]}"
	quest.0351030223C9CAE8.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Звезда → заряженная звезда (\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" зарядов). Расход \"}, {\"text\": \"12\", \"color\": \"#E0C8FF\"}, {\"text\": \" млрд FE на звезду, при \"}, {\"text\": \"1 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE/т — \"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" минут.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Улучшение скорости Maelstrom повышает приём энергии. Нужна энергетика эндгейма (термояд, реактор).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия расходуется по мере поступления — можно заряжать понемногу.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Звезда, заряженная частично, сохраняет прогресс.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь рядом энергоядро/матрицу — зарядник берёт энергию быстро.\"}]}"]
	quest.3EBDFBCA7B610CD8.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Генераторы энергона\"}]}"
	quest.3EBDFBCA7B610CD8.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Красный: заряженная звезда (\"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" заряд) + \"}, {\"text\": \"4000\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ лавы → \"}, {\"text\": \"16\", \"color\": \"#E0C8FF\"}, {\"text\": \" красного энергона. Тёмный — то же с криогеном.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Операция ~\"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" минут при \"}, {\"text\": \"1 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE/т. Звезда — катализатор, тратится по заряду.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Криоген — жидкость IU (охлаждающая), её делает криогенный генератор/машина IU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лава подаётся трубой из бака/помпы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергон — промежуточный продукт: дальше его превращают в жидкость.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"16\", \"color\": \"#E0C8FF\"}, {\"text\": \" энергона за операцию хватает надолго.\"}]}"]
	quest.550E2DEC02FA587A.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Преобразователь энергония\"}]}"
	quest.550E2DEC02FA587A.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Мультиблок \"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"3.\", \"color\": \"#E0C8FF\"}, {\"text\": \" Shift+ПКМ по контроллеру — показывает «призрак» схемы: ставь блоки по подсветке.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергон → жидкий энергоний (\"}, {\"text\": \"125\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ за штуку). Цвет бака задаёт первый вставленный энергон.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Для синтезатора нужно \"}, {\"text\": \"2000\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ красного и \"}, {\"text\": \"2000\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ тёмного энергония — держи два преобразователя.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Расход \"}, {\"text\": \"5 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE на энергон, приём \"}, {\"text\": \"250 тыс.\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE/т (~\"}, {\"text\": \"20 с\", \"color\": \"#E0C8FF\"}, {\"text\": \" на штуку).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Жидкость забирается из порта трубой в бак.\"}]}"]
	quest.1206B08BEC0AF7DD.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Энергонный синтезатор\"}]}"
	quest.1206B08BEC0AF7DD.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Мультиблок \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \" (призрак — Shift+ПКМ). \"}, {\"text\": \"2000\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ красного + \"}, {\"text\": \"2000\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ тёмного энергония → пульсирующий энергонный кристалл.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Второй рецепт синтезатора: пульсирующий кристалл → звёздная материя.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Блоки звёздной материи — топливо Гелиосферы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Синтезатор питается FE через порт.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Строй по призраку: Shift+ПКМ по контроллеру.\"}]}"]
	quest.66CB09D34DCC2415.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Звёздное ядро\"}]}"
	quest.66CB09D34DCC2415.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Слияние Draconic: пробуждённое ядро + \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" пульсирующих кристалла + \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" сплава хаоса. Сердце Гелиосферы.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Сплав хаоса = нейтроний + звёздная материя.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужны инжекторы драконьего тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Звёздное ядро ставится в слот ядра Гелиосферы и не тратится.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Одно ядро — на одну Гелиосферу.\"}]}"]
	quest.3058C5F7D9FCC59C.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Гелиосферный зарядный центр\"}]}"
	quest.3058C5F7D9FCC59C.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Самый большой мультиблок: \"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"9.\", \"color\": \"#E0C8FF\"}, {\"text\": \" В слот ядра — звёздное ядро, топливо — блоки звёздной материи.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Строй по призраку (Shift+ПКМ по контроллеру), ПКМ по собранному — модель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Топливо: \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" блок звёздной материи на операцию.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Делает микрозвезду — источник тепла Термоядерного комплекса.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Энергия — FE через порт.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Самая большая стройка мода — подготовь ~\"}, {\"text\": \"400\", \"color\": \"#E0C8FF\"}, {\"text\": \" блоков корпуса.\"}]}"]
	quest.5BCD90A32A91A00F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Термоядерный плавильный комплекс\"}]}"
	quest.5BCD90A32A91A00F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Мультиблок \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"7\", \"color\": \"#E0C8FF\"}, {\"text\": \"×\"}, {\"text\": \"5.\", \"color\": \"#E0C8FF\"}, {\"text\": \" Источник тепла — микрозвезда. До \"}, {\"text\": \"21\", \"color\": \"#E0C8FF\"}, {\"text\": \" слота предметов → до \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" баков расплава по \"}, {\"text\": \"32\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000\", \"color\": \"#E0C8FF\"}, {\"text\": \" мБ.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"2 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE на слиток, \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" слота параллельно. Расплавы идут в кристаллизатор и нейтронный компрессор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Строй по призраку: Shift+ПКМ по контроллеру.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Баки забираются трубой из портов.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Микрозвезда в слоте тепла не тратится полностью — следи за её запасом.\"}]}"]
	chapter.4BFDACBB53B62BC6.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Солнечные панели и материи LoliLand\"}]}"
	quest.088A074E60AF9F37.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Генератор материи\"}]}"
	quest.088A074E60AF9F37.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Тратит много EU и делает UU-материю. В нашей сборке UU — как в IC\"}, {\"text\": \"2\", \"color\": \"#E0C8FF\"}, {\"text\": \" classic: без сканера и репликатора, только готовые рецепты из UU (в JEI ищи по UU-материи).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Иридий в паке: из UU-материи или в молекулярном преобразователе из железного блока (руда иридия выключена).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Скорость растёт, если класть в слот усилитель (металлолом из утилизатора).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Питание — ВН/СВН, ставь трансформаторы и MFSU рядом.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"UU-материя — жидкость/предмет; рецепты из неё — отдельная категория JEI.\"}]}"]
	quest.5C8F2DA251102BC0.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Трансформаторы ВН и СВН\"}]}"
	quest.5C8F2DA251102BC0.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Для машин высшего напряжения: \"}, {\"text\": \"512\", \"color\": \"#E0C8FF\"}, {\"text\": \" и \"}, {\"text\": \"2048 EU/т\", \"color\": \"#E0C8FF\"}, {\"text\": \". Без них поздние машины IU не запитать от больших хранилищ.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Помни: подать СВН на машину СН = взрыв. Трансформатор ставь вплотную к машине.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Трансформатор СВН нужен генератору материи и квантовым панелям.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь его на линию между MFSU и машиной.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Кабели для ВН — золотые/стекловолокно (оптоволокно) IU.\"}]}"]
	quest.2A3477190243AD38.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Улучшенный генератор материи\"}]}"
	quest.2A3477190243AD38.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Быстрее и экономнее первого. Дальше — продвинутый и совершенный (imp/per).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужен, когда UU-материя идёт на иридий в больших количествах (квантовые инструменты, панели).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Питание — СВН через трансформатор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Усилитель (металлолом) экономит энергию.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Генераторов материи может быть несколько — UU складывается в общий бак.\"}]}"]
	quest.4F3A5C466D372B4F.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Санариум\"}]}"
	quest.4F3A5C466D372B4F.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Материал солнечных панелей IU (как в Advanced Solar Panels): части санариума → санариум → обогащённый санариум и пластины.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Делается только в молекулярном преобразователе (как в LoliLand): светокамень + \"}, {\"text\": \"36 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE. Сначала собери преобразователь.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Санариум нужен всем панелям IU от гибридной и выше.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Обогащённый санариум — для совершенной и квантовой панелей.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: делай с запасом — \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"16\", \"color\": \"#E0C8FF\"}, {\"text\": \" штук.\"}]}"]
	quest.7595A092737F26F6.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Гибридная солнечная панель\"}]}"
	quest.7595A092737F26F6.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Вторая ступень солнечной лестницы IU. Работает днём и слабее ночью, выдаёт EU прямо в кабель под собой.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь на открытом небе — любой блок сверху выключает панель. Дождь снижает выработку.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Буфер панели больше, чем у продвинутой — подключай к батбоксу/CESU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт с углепластиком, лазуритом и иридием — иридий из UU.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь грядкой: несколько панелей на одном кабеле.\"}]}"]
	quest.7333E0CAB3C20A68.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Совершенная солнечная панель\"}]}"
	quest.7333E0CAB3C20A68.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Две гибридные + санариум + хризолит. Большой внутренний буфер — подключай к хранилищу, не прямо к слабой машине.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ночью выдаёт меньше.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь на высоте — тень от гор и деревьев не мешает (нужен только открытый верх).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совершенная панель — деталь квантовой.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Заряжает броню в своём слоте.\"}]}"]
	quest.714278AF81D3457E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Квантовая солнечная панель IU\"}]}"
	quest.714278AF81D3457E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Вершина панелей IU и основа лестницы LoliLand в нашем моде (дисперсионная и дальше).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт: \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" совершенные панели + квантовое ядро + иридий + заряженный аметрин.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Буфер очень большой — только через MFSU/трансформатор.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Квантовое ядро IU делается простым рецептом (см. JEI).\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Квантовая панель — ключ к лестнице LoliLand (дисперсионная).\"}]}"]
	quest.0FDF3E3AA401D6C1.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Ядра тиров\"}]}"
	quest.0FDF3E3AA401D6C1.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Лестница ядер LoliLand: квантовое → дисперсионное → гравитомагнитное → анизотропное → флуктуационное → аберрационное → параметрическое → хромодинамическое → антиматериальное.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Первые ядра — верстак, старшие — экстремальный стол Avaritia. Каждое ядро открывает свою солнечную панель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ядра не ставятся — это детали. Копи их под панели.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ядро делается один раз на панель — следи за количеством.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Название ядра совпадает с названием панели его тира.\"}]}"]
	quest.602EE5C920A1EC75.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Солнечные ядра\"}]}"
	quest.602EE5C920A1EC75.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ядро солнечной панели N-го уровня = ядро тира + детали. \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" — верстак, \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" — экстремальный стол.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ядро уровня N входит в солнечную панель того же тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Солнечных ядер \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" уровней — по одному на тир панели.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ядра \"}, {\"text\": \"5\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" требуют экстремального стола Avaritia.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Копи ядра заранее, когда открывается новый тир.\"}]}"]
	quest.51EC6FFB83BE613E.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Генератор твёрдой материи\"}]}"
	quest.51EC6FFB83BE613E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Машина LoliLand: из материи тира N−\"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" делает материю тира N. Тиров \"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" — T\"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" делает материю IU, T\"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" — искрящуюся.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"T\"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \": \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" булыжника → материя IU за \"}, {\"text\": \"400 тыс.\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE. Дальше — \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"–\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" предыдущих материи и от \"}, {\"text\": \"800 тыс.\", \"color\": \"#E0C8FF\"}, {\"text\": \" до \"}, {\"text\": \"40 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE за штуку.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каждый тир берёт только свой рецепт: нужна лесенка из \"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" генераторов, генератор тира N собирается вокруг тира N−\"}, {\"text\": \"1.\", \"color\": \"#E0C8FF\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Приём T\"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" — \"}, {\"text\": \"4000 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" (операция \"}, {\"text\": \"5 с\", \"color\": \"#E0C8FF\"}, {\"text\": \"), T\"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" — \"}, {\"text\": \"32\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" (≈\"}, {\"text\": \"62 с\", \"color\": \"#E0C8FF\"}, {\"text\": \"). Энергию подавай кабелем с любой стороны.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Вход — сверху/сбоку воронкой или трубой, выход забирай трубой: машина сама ничего не выталкивает.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Окно светится и материя в нём кружится, пока идёт работа.\"}]}"]
	quest.452790D20D88F07B.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Расширенный ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" и промышленный ×\"}, {\"text\": \"12\", \"color\": \"#E0C8FF\"}]}"
	quest.452790D20D88F07B.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Расширенный генератор (×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \") собирается вокруг обычного того же тира, промышленный (×\"}, {\"text\": \"12\", \"color\": \"#E0C8FF\"}, {\"text\": \") — вокруг расширенного.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Скорость ×\"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" / ×\"}, {\"text\": \"12\", \"color\": \"#E0C8FF\"}, {\"text\": \" при той же энергии за операцию: приём FE/т растёт во столько же раз.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Промышленный T\"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" ест \"}, {\"text\": \"384\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \" — ставь рядом реактор или панели Maelstrom.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Искрящаяся материя — это \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" голубых ← \"}, {\"text\": \"8\", \"color\": \"#E0C8FF\"}, {\"text\": \" красных ← … ← \"}, {\"text\": \"256\", \"color\": \"#E0C8FF\"}, {\"text\": \" материй IU: одна обычная лесенка делает её ≈\"}, {\"text\": \"2,7 ч\", \"color\": \"#E0C8FF\"}, {\"text\": \",\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"набор из промышленных — ≈\"}, {\"text\": \"14 мин\", \"color\": \"#E0C8FF\"}, {\"text\": \". Улучшай сначала нижние тиры: их операций больше всего.\"}]}"]
