	quest.3A9FC8846E74703E.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Вершина материй: генератор T\"}, {\"text\": \"10,\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" сыпучих голубых материи и \"}, {\"text\": \"40 млн\", \"color\": \"#E0C8FF\"}, {\"text\": \" FE за штуку.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Нужна один раз — в искрящееся ядро (финал). Генератор T\"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" собирается из T\"}, {\"text\": \"9\", \"color\": \"#E0C8FF\"}, {\"text\": \" + кристальная матрица, золотые кристаллы и ядра виверны.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Совет: копи голубые материи заранее, пока строишь антиматериальную панель.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Операция T\"}, {\"text\": \"10\", \"color\": \"#E0C8FF\"}, {\"text\": \" ×\"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" — ≈\"}, {\"text\": \"62 с\", \"color\": \"#E0C8FF\"}, {\"text\": \" при \"}, {\"text\": \"32\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"000 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \"; промышленный ×\"}, {\"text\": \"12\", \"color\": \"#E0C8FF\"}, {\"text\": \" — около \"}, {\"text\": \"5 с\", \"color\": \"#E0C8FF\"}, {\"text\": \".\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Чёрный корпус с золотым свечением — пустотный тир, как у старших ядер.\"}]}"]
	quest.497CD97810B4D924.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Дисперсионная панель\"}]}"
	quest.497CD97810B4D924.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Первая панель LoliLand: квантовая панель IU + солнечное ядро \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \" + материя тира + заряженный флюорит.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Днём \"}, {\"text\": \"49\", \"color\": \"#E0C8FF\"}, {\"text\": \" \"}, {\"text\": \"152 FE/т\", \"color\": \"#E0C8FF\"}, {\"text\": \", ночью \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"/\"}, {\"text\": \"4.\", \"color\": \"#E0C8FF\"}, {\"text\": \" Нужно открытое небо. Отдаёт FE в соседние блоки и кабели.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Каждая следующая панель ≈ ×\"}, {\"text\": \"3\", \"color\": \"#E0C8FF\"}, {\"text\": \" мощнее и собирается из двух предыдущих + панели на тир ниже + ядро и материя тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь на кабель Mekanism/Flux — буфер панели большой.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ночью выработка \"}, {\"text\": \"1\", \"color\": \"#E0C8FF\"}, {\"text\": \"/\"}, {\"text\": \"4\", \"color\": \"#E0C8FF\"}, {\"text\": \" — ставь хранилище.\"}]}"]
	quest.70F7DA47ED50EDF0.title: "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#C99BFF\", \"extra\": [{\"text\": \"Термодинамические панели\"}]}"
	quest.70F7DA47ED50EDF0.quest_desc: ["{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Боковая лестница: фиолетовая → красная → прозрачная → бирюзовая → ультимативная голографическая.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Основа — тепловой генератор Mekanism и термодинамические ядра. Работают и ночью, но слабее солнечных своего тира.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ультимативная голографическая — одна из \"}, {\"text\": \"6\", \"color\": \"#E0C8FF\"}, {\"text\": \" «ультимативных» для искрящейся панели.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Рецепт каждой — в JEI.\"}]}", "{\"text\": \"\", \"font\": \"maelstromtech:neon\", \"color\": \"#B57BFF\", \"extra\": [{\"text\": \"Ставь на открытом небе.\"}]}"]
